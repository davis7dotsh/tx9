# Encrypted state archives are large / secret — never commit.
/backups/*
!/backups/.gitkeep
*.tar.gz
*.tar.gz.gpg

# Local registry of boxes created on this machine.
/.boxes
/.boxes.tmp
/.box-locks/

# Optional private/custom Hermes Git bundles used for exact-SHA provisioning.
/artifacts/*
!/artifacts/.gitkeep

__pycache__/
/.boxd-locks/
