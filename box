#!/usr/bin/env bash
# hermes-box-lite — isolated, portable agent boxes whose durable state lives in
# /data. Runtime: smolvm. Backups are encrypted state archives, not VM images.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
# shellcheck source=box.env
source "$ROOT/box.env"
# shellcheck source=guest/lib-mcp.sh
source "$ROOT/guest/lib-mcp.sh"

REG="$ROOT/.boxes"
LOCK_ROOT="$ROOT/.box-locks"
_BOX_PASS=""
_TEMP_PATHS=()
_LOCK_DIRS=()
_PAUSED_BOXES=()
_PAUSED_RESUME_ON_CLEANUP=()
_GUEST_TEMP_BOXES=()
_GUEST_TEMP_PATHS=()
_CREATED_BOXES=()
_STOP_AFTER_BOXES=()
_PENDING_SIGNAL=0
_LOCK_FAILURE=""

die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
say() { printf '\033[36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

_cleanup() {
  local status=$? n path index
  trap - EXIT HUP INT TERM
  set +e
  for index in "${!_GUEST_TEMP_PATHS[@]}"; do
    n="${_GUEST_TEMP_BOXES[$index]}"
    path="${_GUEST_TEMP_PATHS[$index]}"
    [[ -n "$n" && -n "$path" ]] || continue
    smolvm machine exec --name "$n" -- rm -f -- "$path" >/dev/null 2>&1 || true
  done
  for path in "${_TEMP_PATHS[@]:-}"; do
    [[ -n "$path" ]] && rm -f -- "$path"
  done
  for n in "${_CREATED_BOXES[@]:-}"; do
    [[ -n "$n" ]] || continue
    _rollback_created "$n" || true
  done
  for index in "${!_PAUSED_BOXES[@]}"; do
    n="${_PAUSED_BOXES[$index]}"
    [[ -n "$n" && "${_PAUSED_RESUME_ON_CLEANUP[$index]}" == 1 ]] || continue
    _guest_hb "$n" resume >/dev/null 2>&1 || true
  done
  for n in "${_STOP_AFTER_BOXES[@]:-}"; do
    [[ -n "$n" ]] && smolvm machine stop --name "$n" >/dev/null 2>&1 || true
  done
  for path in "${_LOCK_DIRS[@]:-}"; do
    [[ -n "$path" ]] || continue
    if [[ -r "$path/pid" && "$(cat "$path/pid")" == "$$" ]]; then rm -f "$path/pid"; fi
    rmdir "$path" >/dev/null 2>&1 || true
  done
  exit "$status"
}

_install_cleanup_traps() {
  trap _cleanup EXIT
  _install_signal_traps
}

_install_signal_traps() {
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

_defer_signals() {
  _PENDING_SIGNAL=0
  trap '_PENDING_SIGNAL=129' HUP
  trap '_PENDING_SIGNAL=130' INT
  trap '_PENDING_SIGNAL=143' TERM
}

_honor_pending_signal() {
  local status="$_PENDING_SIGNAL"
  _PENDING_SIGNAL=0
  [[ "$status" == 0 ]] || exit "$status"
}

_track_temp() { _TEMP_PATHS+=("$1"); }

_track_guest_temp() {
  _GUEST_TEMP_BOXES+=("$1")
  _GUEST_TEMP_PATHS+=("$2")
}

_untrack_guest_temp() {
  local n="$1" path="$2" index
  for index in "${!_GUEST_TEMP_PATHS[@]}"; do
    if [[ "${_GUEST_TEMP_BOXES[$index]}" == "$n" && "${_GUEST_TEMP_PATHS[$index]}" == "$path" ]]; then
      _GUEST_TEMP_BOXES[index]=""
      _GUEST_TEMP_PATHS[index]=""
    fi
  done
}

_track_stop_after() { _STOP_AFTER_BOXES+=("$1"); }
_clear_stop_after() {
  local n="$1" index
  for index in "${!_STOP_AFTER_BOXES[@]}"; do
    [[ "${_STOP_AFTER_BOXES[$index]}" == "$n" ]] && _STOP_AFTER_BOXES[index]=""
  done
}

_mark_created() { _CREATED_BOXES+=("$1"); }

_clear_created() {
  local n="$1" index
  for index in "${!_CREATED_BOXES[@]}"; do
    [[ "${_CREATED_BOXES[$index]}" == "$n" ]] && _CREATED_BOXES[index]=""
  done
}

_require() { have "$1" || die "$1 not found on PATH"; }

_host_preflight() {
  local mode="${1:-full}" cmd requirements=()
  case "$mode" in
    basic) requirements=(awk smolvm) ;;
    provision) requirements=(awk smolvm tar) ;;
    health) requirements=(awk curl jq mktemp smolvm) ;;
    import) requirements=(awk jq mktemp python3 smolvm) ;;
    archive) requirements=(awk gpg grep mktemp python3 tar) ;;
    full) requirements=(awk curl gpg grep jq mktemp python3 smolvm tar) ;;
    *) die "unknown host preflight mode '$mode'" ;;
  esac
  for cmd in "${requirements[@]}"; do _require "$cmd"; done
}

_validate_name() {
  local n="$1"
  [[ "$n" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$ ]] ||
    die "invalid box name '$n' (use 1-63 letters, numbers, dots, underscores, or dashes)"
}

_try_acquire_lock() {
  local key="$1" dir="$LOCK_ROOT/$1.lock"
  _LOCK_FAILURE=""
  if ! mkdir -p "$LOCK_ROOT"; then
    _LOCK_FAILURE="could not create the lock directory"
    return 1
  fi
  if ! mkdir "$dir" 2>/dev/null; then
    local owner=""
    [[ -r "$dir/pid" ]] && owner="$(cat "$dir/pid")"
    if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
      rm -rf "$dir"
      if ! mkdir "$dir" 2>/dev/null; then
        _LOCK_FAILURE="could not recover stale '$key' lock"
        return 1
      fi
    else
      _LOCK_FAILURE="another operation already holds the '$key' lock${owner:+ (pid $owner)}"
      return 1
    fi
  fi
  if ! printf '%s\n' "$$" >"$dir/pid"; then
    rm -f -- "$dir/pid"
    rmdir "$dir" >/dev/null 2>&1 || true
    _LOCK_FAILURE="could not record ownership of the '$key' lock"
    return 1
  fi
  _LOCK_DIRS+=("$dir")
}

_acquire_lock() {
  local key="$1"
  _try_acquire_lock "$key" || die "$_LOCK_FAILURE"
}

_release_lock() {
  local dir="$LOCK_ROOT/$1.lock"
  rm -f "$dir/pid"
  rmdir "$dir" >/dev/null 2>&1 || true
}

# One line per managed box: name, Executor host port, Hermes API host port,
# Hermes API guest bridge port. Legacy two-column rows remain valid.
# metadata; the VM remains the source of truth for whether an instance exists.
_reg_add() {
  touch "$REG"
  _reg_del "$1"
  printf '%s\t%s\t%s\t%s\n' "$1" "${2:-}" "${3:-}" "${4:-}" >>"$REG"
}
_reg_del() {
  [[ -f "$REG" ]] || return 0
  awk -F'\t' -v n="$1" '$1!=n' "$REG" >"$REG.tmp"
  mv "$REG.tmp" "$REG"
}
_reg_port() { [[ -f "$REG" ]] && awk -F'\t' -v n="$1" '$1==n{print $2}' "$REG"; }
_reg_exists() { [[ -f "$REG" ]] && awk -F'\t' -v n="$1" '$1==n{found=1} END{exit !found}' "$REG"; }
_reg_api_port() { [[ -f "$REG" ]] && awk -F'\t' -v n="$1" '$1==n{print $3}' "$REG"; }
_reg_api_guest_port() { [[ -f "$REG" ]] && awk -F'\t' -v n="$1" '$1==n{print $4}' "$REG"; }

_machine_exists() { smolvm machine status --name "$1" >/dev/null 2>&1; }
_machine_running() {
  local status
  status="$(smolvm machine status --name "$1" 2>/dev/null)" && grep -q ': running' <<<"$status"
}

_tcp_port_open() {
  local host="$1" port="$2"
  (exec 3<>"/dev/tcp/$host/$port") 2>/dev/null
}

_port_free() {
  awk -F'\t' -v p="$1" '$2==p || $3==p || $4==p{f=1} END{exit !f}' "$REG" 2>/dev/null && return 1
  _tcp_port_open 127.0.0.1 "$1" && return 1
  _tcp_port_open ::1 "$1" && return 1
  return 0
}

_wait_mcp_ready() {
  local url="$1" token="$2" attempt
  for ((attempt = 0; attempt < 30; attempt++)); do
    _mcp_initialize "$url" "$token" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

_hermes_api_healthy() {
  local port="$1" body code
  body="$(mktemp)" || return 1
  _track_temp "$body"
  code="$(curl -sS --connect-timeout 2 --max-time 5 -o "$body" -w '%{http_code}' \
    "http://127.0.0.1:${port}/health")" || return 1
  [[ "$code" =~ ^2[0-9][0-9]$ ]] || return 1
  jq -e '.status == "ok" and .platform == "hermes-agent"' "$body" >/dev/null 2>&1
}

_assign_port() {
  local lo="$1" hi="$2" label="$3" forbidden="${4:-}" p attempt
  [[ "$lo" =~ ^[0-9]+$ && "$hi" =~ ^[0-9]+$ && "$lo" -ge 1024 && "$hi" -le 65535 && "$lo" -le "$hi" ]] ||
    die "invalid ${label} port range ${lo}-${hi}"
  for ((attempt = 0; attempt < 300; attempt++)); do
    p=$((lo + RANDOM % (hi - lo + 1)))
    [[ "$p" != "$forbidden" ]] && _port_free "$p" && { printf '%s' "$p"; return 0; }
  done
  die "no free host port in ${lo}-${hi}"
}

_validate_resources() {
  BOX_CPUS="${BOX_CPUS:-4}"
  BOX_MEM_MIB="${BOX_MEM_MIB:-8192}"
  BOX_OVERLAY_GIB="${BOX_OVERLAY_GIB:-64}"
  BOX_STORAGE_GIB="${BOX_STORAGE_GIB:-}"
  [[ "${BOX_CPUS:-}" =~ ^[1-9][0-9]*$ && "${BOX_CPUS}" -le 128 ]] || die "BOX_CPUS must be 1-128"
  [[ "${BOX_MEM_MIB:-}" =~ ^[1-9][0-9]*$ && "${BOX_MEM_MIB}" -ge 512 ]] || die "BOX_MEM_MIB must be at least 512"
  [[ "${BOX_OVERLAY_GIB:-}" =~ ^[1-9][0-9]*$ ]] || die "BOX_OVERLAY_GIB must be a positive integer"
  [[ -z "${BOX_STORAGE_GIB:-}" || "${BOX_STORAGE_GIB}" =~ ^[1-9][0-9]*$ ]] || die "BOX_STORAGE_GIB must be empty or a positive integer"
}

_validate_bundle() {
  local bundle="${HERMES_GIT_BUNDLE:-}"
  [[ -n "$bundle" ]] || return 0
  _require git
  [[ "$bundle" != /* && "$bundle" != *..* && "$bundle" == artifacts/* ]] ||
    die "HERMES_GIT_BUNDLE must be a safe repository-relative path beneath artifacts/"
  [[ -f "$ROOT/$bundle" ]] || die "Hermes Git bundle not found: $ROOT/$bundle"
  git bundle verify "$ROOT/$bundle" >/dev/null 2>&1 || die "invalid Hermes Git bundle: $bundle"
}

_resolve_passphrase() {
  local confirm="${1:-}" p1 p2
  [[ -n "$_BOX_PASS" ]] && return
  if [[ -n "${BOX_PASSPHRASE_FILE:-}" ]]; then
    [[ -r "$BOX_PASSPHRASE_FILE" ]] || die "BOX_PASSPHRASE_FILE is not readable"
    IFS= read -r _BOX_PASS <"$BOX_PASSPHRASE_FILE" || true
    [[ -n "$_BOX_PASS" ]] || die "BOX_PASSPHRASE_FILE is empty"
    return
  fi
  if [[ -n "${BOX_PASSPHRASE:-}" ]]; then
    _BOX_PASS="$BOX_PASSPHRASE"
    return
  fi
  [[ -r /dev/tty ]] || die "no BOX_PASSPHRASE set and no terminal to prompt on"
  printf 'Passphrase: ' >/dev/tty
  read -rs p1 </dev/tty
  printf '\n' >/dev/tty
  if [[ "$confirm" == confirm ]]; then
    printf 'Confirm passphrase: ' >/dev/tty
    read -rs p2 </dev/tty
    printf '\n' >/dev/tty
    [[ "$p1" == "$p2" ]] || die "passphrases do not match"
  fi
  [[ -n "$p1" ]] || die "empty passphrase"
  _BOX_PASS="$p1"
}

gpg_enc() {
  _resolve_passphrase confirm
  gpg --batch --yes --pinentry-mode loopback --passphrase-fd 3 \
    --symmetric --cipher-algo AES256 -o "$1" 3<<<"$_BOX_PASS"
}

gpg_dec() {
  _resolve_passphrase
  gpg --batch --yes --pinentry-mode loopback --passphrase-fd 3 -d "$1" 3<<<"$_BOX_PASS"
}

_validate_archive() {
  python3 - "$1" <<'PY'
import sys
import tarfile
from pathlib import PurePosixPath

def safe_text(value, label):
    if "\x00" in value or any(ord(char) < 32 or ord(char) == 127 for char in value):
        raise ValueError(f"{label} contains control characters")

def link_parts(value):
    safe_text(value, "archive link target")
    path = PurePosixPath(value)
    if path.is_absolute():
        raise ValueError("archive link target is absolute")
    return [part for part in path.parts if part not in {"", "."}]

def validate_link_target(member, key):
    parts = link_parts(member.linkname)
    if not parts:
        raise ValueError("archive link target is empty")
    resolved = key.split("/")[:-1] if member.issym() else []
    for part in parts:
        if part == "..":
            if not resolved:
                raise ValueError("archive link target lexically escapes extraction root")
            resolved.pop()
        else:
            resolved.append(part)

try:
    with tarfile.open(sys.argv[1], "r:gz") as archive:
        members = archive.getmembers()
        if not members:
            raise ValueError("archive is empty")
        by_name = {}
        for member in members:
            name = member.name
            safe_text(name, "archive path")
            path = PurePosixPath(name)
            if path.is_absolute() or any(part == ".." for part in path.parts):
                raise ValueError("archive path escapes its extraction root")
            parts = tuple(part for part in path.parts if part not in {"", "."})
            key = "/".join(parts)
            if key in by_name:
                raise ValueError(f"archive contains duplicate path: {key or '.'}")
            if not (member.isfile() or member.isdir() or member.issym() or member.islnk()):
                raise ValueError("archive contains a device, FIFO, socket, or unknown special file")
            if not key and not member.isdir():
                raise ValueError("archive root member must be a real directory")
            if member.issym() or member.islnk():
                validate_link_target(member, key)
            by_name[key] = member

        for key in by_name:
            parts = key.split("/") if key else []
            for length in range(1, len(parts)):
                parent = by_name.get("/".join(parts[:length]))
                if parent is not None and (parent.issym() or parent.islnk()):
                    raise ValueError(f"archive member is nested beneath a link: {key}")

        for required in ("home", "home/agent"):
            entry = by_name.get(required)
            if entry is None or not entry.isdir() or entry.issym() or entry.islnk():
                raise ValueError(f"{required} must be a real directory")

        def resolve(key):
            pending = key.split("/") if key else []
            resolved = []
            seen_states = set()
            steps = 0
            while pending:
                steps += 1
                if steps > len(by_name) * 8 + 32:
                    raise ValueError("archive link chain exceeds safety bound")
                state = (tuple(resolved), tuple(pending))
                if state in seen_states:
                    raise ValueError("archive link cycle detected")
                seen_states.add(state)
                part = pending.pop(0)
                if part in {"", "."}:
                    continue
                if part == "..":
                    if not resolved:
                        raise ValueError("archive link target escapes extraction root")
                    resolved.pop()
                    continue
                candidate = "/".join((*resolved, part))
                entry = by_name.get(candidate)
                if entry is not None and (entry.issym() or entry.islnk()):
                    base = candidate.split("/")[:-1] if entry.issym() else []
                    pending = base + link_parts(entry.linkname) + pending
                    resolved = []
                    continue
                if pending and (entry is None or not entry.isdir()):
                    raise ValueError(f"archive path resolves through missing or non-directory member: {candidate}")
                resolved.append(part)
            final = "/".join(resolved)
            entry = by_name.get(final)
            if entry is None:
                raise ValueError(f"archive link resolves to missing member: {final or '.'}")
            return entry

        for key, member in by_name.items():
            if not key:
                continue
            parent = key.rpartition("/")[0]
            if parent and not resolve(parent).isdir():
                raise ValueError(f"archive member parent is not a directory: {key}")
            if member.issym() or member.islnk():
                target = resolve(key)
                if member.islnk() and not target.isfile():
                    raise ValueError("archive hardlink does not resolve to a regular file")
except (OSError, tarfile.TarError, ValueError) as error:
    print(f"unsafe archive: {error}", file=sys.stderr)
    raise SystemExit(1)
PY
}

_guest_hb() {
  local n="$1"
  shift
  smolvm machine exec --name "$n" -- \
    setpriv --reuid=agent --regid=agent --init-groups \
    env HOME=/data/home/agent bash --noprofile --norc -c \
    '. /etc/profile.d/hermes-box.sh; exec hb "$@"' hb "$@"
}

_pause_box() {
  local n="$1" resume_on_cleanup="${2:-1}"
  if _guest_hb "$n" is-paused >/dev/null 2>&1; then return; fi
  _PAUSED_BOXES+=("$n")
  _PAUSED_RESUME_ON_CLEANUP+=("$resume_on_cleanup")
  if ! _guest_hb "$n" pause; then return 1; fi
  _guest_hb "$n" is-paused >/dev/null 2>&1
}

_resume_box() {
  local n="$1" index
  for index in "${!_PAUSED_BOXES[@]}"; do
    if [[ "${_PAUSED_BOXES[$index]}" == "$n" ]]; then
      _guest_hb "$n" resume || return 1
      _PAUSED_BOXES[index]=""
      _PAUSED_RESUME_ON_CLEANUP[index]=""
      return
    fi
  done
}

_create_base() {
  local n="$1" port="" api_port="" api_guest_port="" wl_port create_status opts=() resources=()
  _validate_resources
  _validate_bundle
  _acquire_lock registry
  ! _reg_exists "$n" || { _release_lock registry; die "box '$n' is already registered"; }
  if _machine_exists "$n"; then
    _release_lock registry
    die "smolvm machine '$n' already exists"
  fi
  if [[ "${INSTALL_EXECUTOR:-0}" == 1 && "${EXPOSE_EXECUTOR_WEB:-0}" == 1 ]]; then
    port="$(_assign_port "${EXECUTOR_PORT_LO:-4790}" "${EXECUTOR_PORT_HI:-4999}" executor)" || { _release_lock registry; return 1; }
    opts+=(-p "${port}:${port}")
    say "Assigned host port ${port} -> executor (http://localhost:${port})"
  fi
  if [[ "${INSTALL_HERMES:-0}" == 1 && "${EXPOSE_HERMES_API:-0}" == 1 ]]; then
    api_port="$(_assign_port "${HERMES_API_PORT_LO:-8650}" "${HERMES_API_PORT_HI:-8850}" 'Hermes API' "$port")" || { _release_lock registry; return 1; }
    api_guest_port="$api_port"
    opts+=(-p "${api_port}:${api_guest_port}")
    say "Assigned host port ${api_port} -> Hermes API (http://localhost:${api_port})"
  fi
  resources=(--cpus "$BOX_CPUS" --mem "$BOX_MEM_MIB" --overlay "$BOX_OVERLAY_GIB")
  [[ -z "${BOX_STORAGE_GIB:-}" ]] || resources+=(--storage "$BOX_STORAGE_GIB")
  wl_port="${port:-4788}"
  _defer_signals
  # No `exec` into hb-workload: if the loop process itself dies (OOM-killed, a
  # bug not guarded by its `set -u`), nothing else in the VM restarts it, so
  # this outer loop is the supervisor. hb-workload's own internals (gateway,
  # socat bridges) are reconciled every 20s once it's running again.
  if smolvm machine create --net "${opts[@]}" "${resources[@]}" --name "$n" --image "$BASE_IMAGE" \
    -- bash -c "while [ ! -x /opt/hermes-box/bin/hb-workload ]; do sleep 2; done
      while true; do runuser -u agent -- env HOME=/data/home/agent /opt/hermes-box/bin/hb-workload ${wl_port} ${api_guest_port:-0}; sleep 2; done"; then
    create_status=0
  else
    create_status=$?
  fi
  if [[ "$create_status" != 0 ]]; then
    _install_signal_traps
    _release_lock registry
    warn "smolvm create failed for '$n'; ownership is unknown, so no VM will be deleted automatically"
    warn "inspect with: smolvm machine status --name '$n'"
    _honor_pending_signal
    return 1
  fi
  _mark_created "$n"
  if ! _reg_add "$n" "$port" "$api_port" "$api_guest_port"; then
    _install_signal_traps
    _release_lock registry
    _honor_pending_signal
    return 1
  fi
  _install_signal_traps
  _release_lock registry
  _honor_pending_signal
  smolvm machine start --name "$n"
}

_provision_into() {
  local n="$1" mode="${2:-full}" log_file="${3:-}" contexts=(provision guest box.env) cmd
  if [[ "$mode" == full ]]; then
    _validate_bundle
    [[ -z "${HERMES_GIT_BUNDLE:-}" ]] || contexts+=("$HERMES_GIT_BUNDLE")
  fi
  say "Streaming provision context into '$n'"
  if ! COPYFILE_DISABLE=1 tar czf - -C "$ROOT" "${contexts[@]}" \
    | smolvm machine exec -i --name "$n" -- bash -lc 'cat >/tmp/ctx.tgz'; then
    return 1
  fi
  if [[ "$mode" == assets ]]; then
    say "Refreshing managed guest assets"
  else
    say "Provisioning node/uv, claude, codex, hermes, executor (a few minutes)…"
  fi
  cmd="set -e
    rm -rf /tmp/ctx && mkdir -p /tmp/ctx
    tar xzf /tmp/ctx.tgz -C /tmp/ctx
    bash /tmp/ctx/provision/provision.sh '$mode'"
  # Optionally tee the transcript to a host-side file so a caller can persist
  # it as failure evidence before rollback deletes the only other copy.
  if [[ -n "$log_file" ]]; then
    smolvm machine exec --name "$n" -- bash -lc "$cmd" 2>&1 | tee "$log_file"
  else
    smolvm machine exec --name "$n" -- bash -lc "$cmd"
  fi
}

_prepare_runtime() {
  local n="$1"
  _guest_hb "$n" up || return 1
  _guest_hb "$n" wire-once || return 1
  _guest_hb "$n" doctor
}

# Best-effort: a failure saving the transcript (full disk, read-only checkout)
# must never itself abort the caller's failure-handling path under set -e —
# that would skip keep-on-failure's _clear_created and let the EXIT trap roll
# the box back anyway, defeating the one thing the operator needed most.
_save_failed_transcript() {
  local n="$1" log_file="$2" failed_log
  [[ -s "$log_file" ]] || return 0
  if ! mkdir -p backups/.failed; then
    warn "could not create backups/.failed; provisioning transcript was not saved"
    return 0
  fi
  failed_log="backups/.failed/${n}-$(date -u +%Y%m%dT%H%M%SZ).log"
  if cp "$log_file" "$failed_log"; then
    warn "provisioning transcript saved to $failed_log"
  else
    warn "could not save provisioning transcript to $failed_log"
  fi
}

_rollback_created() {
  local n="$1" registry_lock="$LOCK_ROOT/registry.lock" owns_lock=0
  warn "rolling back incomplete box '$n'"
  if ! smolvm machine delete --name "$n" -f >/dev/null 2>&1; then
    warn "could not remove incomplete box '$n'; registry metadata was preserved"
    warn "recover with: ./box rm '$n' --force"
    return 1
  fi
  if _machine_exists "$n"; then
    warn "could not remove incomplete box '$n'; registry metadata was preserved"
    warn "recover with: ./box rm '$n' --force"
    return 1
  fi
  if [[ -r "$registry_lock/pid" && "$(cat "$registry_lock/pid" 2>/dev/null)" == "$$" ]]; then
    owns_lock=1
  elif _try_acquire_lock registry; then
    owns_lock=1
  fi
  if [[ "$owns_lock" != 1 ]]; then
    warn "removed VM '$n', but the registry lock is busy; metadata was preserved"
    warn "after the other operation finishes, remove the stale '$n' entry from $REG"
    return 1
  fi
  if ! _reg_del "$n"; then
    warn "removed VM '$n', but failed to update $REG"
    _release_lock registry
    return 1
  fi
  _release_lock registry
  return 0
}

cmd_new() {
  local n="${1:?usage: box new <name> [--keep-on-failure]}" keep_on_failure=0 stage="" log_file
  [[ "${2:-}" != --keep-on-failure && "${BOX_KEEP_ON_FAILURE:-0}" != 1 ]] || keep_on_failure=1
  _validate_name "$n"
  _host_preflight provision
  _acquire_lock "$n"
  say "Creating instance '$n' from $BASE_IMAGE"
  log_file="$(mktemp)"
  _track_temp "$log_file"
  if ! _create_base "$n"; then
    stage="creating the base VM"
  elif ! _provision_into "$n" full "$log_file"; then
    stage="provisioning"
  elif ! _prepare_runtime "$n"; then
    stage="preparing the runtime (gateway start, MCP wiring, doctor)"
  fi
  if [[ -n "$stage" ]]; then
    _save_failed_transcript "$n" "$log_file"
    if [[ "$keep_on_failure" == 1 ]]; then
      _clear_created "$n"
      warn "leaving '$n' in place for inspection (--keep-on-failure / BOX_KEEP_ON_FAILURE=1)"
      warn "inspect with: smolvm machine exec --name '$n' -- bash"
      warn "remove when done with: ./box rm '$n' --force"
    fi
    die "box creation failed while $stage"
  fi
  _clear_created "$n"
  local port
  port="$(_reg_port "$n")"
  say "Ready. Enter with: ./box enter $n"
  [[ -n "$port" ]] && say "Executor web: http://localhost:${port} (./box open $n)"
  say "Authenticate inside, then ./box save $n to capture the state."
}

cmd_enter() {
  local n="${1:?usage: box enter <name>}"
  _validate_name "$n"
  _host_preflight basic
  smolvm machine start --name "$n" >/dev/null
  exec smolvm machine exec -it --name "$n" -- login -f agent
}

cmd_save() {
  local n="${1:?usage: box save <name> [out.tar.gz.gpg]}" ts out raw encrypted guest_tmp
  _validate_name "$n"
  _host_preflight full
  _acquire_lock "$n"
  ts="$(date +%Y%m%d-%H%M%S)"
  out="${2:-backups/${n}-${ts}.tar.gz.gpg}"
  [[ ! -e "$out" ]] || die "refusing to overwrite existing backup: $out"
  mkdir -p "$(dirname "$out")"
  raw="$(mktemp)"
  encrypted="$(mktemp "${out}.tmp.XXXXXX")"
  guest_tmp="/root/hb-data-${ts}-$$-${RANDOM}.tgz"
  _track_temp "$raw"
  _track_temp "$encrypted"
  _track_guest_temp "$n" "$guest_tmp"

  say "Quiescing Hermes and Executor inside '$n'"
  _pause_box "$n"
  _guest_hb "$n" verify-state --checkpoint >/dev/null
  _guest_hb "$n" write-manifest
  say "Archiving /data inside '$n'"
  # shellcheck disable=SC2016 # expanded by the guest shell; archive is positional
  smolvm machine exec --name "$n" -- bash -c \
    'set -euo pipefail; umask 077; archive=$1; sync
     tar czf "$archive" -C /data \
       --exclude="./home/agent/.config/hermes-box/quiesced" \
       --exclude="*/node_modules" --exclude="*/.venv" --exclude="*/venv" \
       --exclude="*/__pycache__" --exclude="*/.cache" \
       --exclude="*.pyc" --exclude="*.pyo" \
       --exclude="*/.hermes/*.db-wal" --exclude="*/.hermes/*.db-shm" \
       --exclude="*/.hermes/*.db-journal" \
       --exclude="*/gateway.pid" --exclude="*/cron.pid" --exclude="*/gateway.lock" \
       --exclude="*/processes.json" .' bash "$guest_tmp"
  smolvm machine cp "$n:$guest_tmp" "$raw"
  smolvm machine exec --name "$n" -- rm -f -- "$guest_tmp"
  _untrack_guest_temp "$n" "$guest_tmp"
  _validate_archive "$raw" || die "generated archive failed validation"
  _resume_box "$n"

  say "Encrypting and verifying backup"
  gpg_enc "$encrypted" <"$raw"
  gpg_dec "$encrypted" | tar tzf - >/dev/null || die "encrypted backup verification failed"
  ln "$encrypted" "$out" 2>/dev/null || die "backup destination appeared during save: $out"
  rm -f "$encrypted"
  say "Saved and verified $(du -h "$out" | cut -f1) -> $out"
}

cmd_load() {
  local file="${1:?usage: box load <archive.tar.gz.gpg> [name] [--keep-on-failure]}" n="${2:-restored}" raw guest_tmp
  local keep_on_failure=0 log_file stage=""
  [[ "${3:-}" != --keep-on-failure && "${BOX_KEEP_ON_FAILURE:-0}" != 1 ]] || keep_on_failure=1
  [[ -f "$file" ]] || die "no such archive: $file"
  _validate_name "$n"
  _host_preflight full
  _acquire_lock "$n"
  raw="$(mktemp)"
  _track_temp "$raw"
  say "Decrypting and validating archive before creating a VM"
  gpg_dec "$file" >"$raw"
  _validate_archive "$raw" || die "archive is invalid or unsafe"

  say "Creating and provisioning fresh instance '$n'"
  log_file="$(mktemp)"
  _track_temp "$log_file"
  if ! _create_base "$n"; then
    stage="creating the base VM"
  elif ! _provision_into "$n" full "$log_file"; then
    stage="provisioning"
  fi
  if [[ -n "$stage" ]]; then
    _save_failed_transcript "$n" "$log_file"
    if [[ "$keep_on_failure" == 1 ]]; then
      _clear_created "$n"
      warn "leaving '$n' in place for inspection (--keep-on-failure / BOX_KEEP_ON_FAILURE=1)"
      warn "remove when done with: ./box rm '$n' --force"
    fi
    die "box load failed while $stage"
  fi

  guest_tmp="/root/hb-restore-$(date +%Y%m%d-%H%M%S)-$$-${RANDOM}.tgz"
  _track_guest_temp "$n" "$guest_tmp"
  # shellcheck disable=SC2016 # expanded by the guest shell; archive is positional
  if ! _pause_box "$n" 0 || ! smolvm machine cp "$raw" "$n:$guest_tmp" ||
    ! smolvm machine exec --name "$n" -- chmod 0600 "$guest_tmp" ||
    ! smolvm machine exec --name "$n" -- bash -c \
      'set -euo pipefail
       archive=$1
       trap '\''rm -f -- "$archive"'\'' EXIT HUP INT TERM
       stage=/data/.hb-restore-stage-$$
       rollback=/data/.hb-restore-rollback-$$
       rm -rf "$stage" "$rollback"
       mkdir -m 0700 "$stage" "$rollback"
       tar xzf "$archive" --no-same-owner -C "$stage"
       test -d "$stage/home/agent"
       chown root:root "$stage" "$stage/home"
       chmod 0711 "$stage" "$stage/home"
       chown -R agent:agent "$stage/home/agent" "$stage/logs" 2>/dev/null || true
       test "$(stat -c %u "$stage")" = 0
       test "$(stat -c %u "$stage/home")" = 0
       test "$(stat -c %a "$stage")" = 711
       test "$(stat -c %a "$stage/home")" = 711
       mkdir -p "$stage/home/agent/.config/hermes-box"
       touch "$stage/home/agent/.config/hermes-box/quiesced" \
         "$stage/home/agent/.config/hermes-box/gateway-disabled" \
         "$stage/home/agent/.config/hermes-box/gateway-policy-initialized"
       chown -R agent:agent "$stage/home/agent/.config/hermes-box"
       setpriv --reuid=agent --regid=agent --init-groups test -x "$stage"
       setpriv --reuid=agent --regid=agent --init-groups test ! -w "$stage"
       setpriv --reuid=agent --regid=agent --init-groups test -x "$stage/home"
       setpriv --reuid=agent --regid=agent --init-groups test ! -w "$stage/home"
       setpriv --reuid=agent --regid=agent --init-groups test -w "$stage/home/agent"
       setpriv --reuid=agent --regid=agent --init-groups env HOME=/data/home/agent \
         /opt/hermes-box/bin/hermes-state verify --home "$stage/home/agent/.hermes" >/dev/null
       shopt -s dotglob nullglob
       for item in /data/*; do
         [[ "$item" == "$stage" || "$item" == "$rollback" ]] && continue
         mv "$item" "$rollback/"
       done
       restore_failed=1
       trap '\''if [[ "$restore_failed" == 1 ]]; then find /data -mindepth 1 -maxdepth 1 ! -path "$rollback" -exec rm -rf -- {} +; mv "$rollback"/* /data/ 2>/dev/null || true; fi; rm -rf "$stage" "$rollback"; rm -f -- "$archive"'\'' EXIT HUP INT TERM
       mv "$stage"/* /data/
       restore_failed=0' bash "$guest_tmp" ||
    ! _provision_into "$n" assets "$log_file" || ! _guest_hb "$n" gateway-disable ||
    ! _guest_hb "$n" verify-state >/dev/null || ! _resume_box "$n" || ! _prepare_runtime "$n"; then
    _save_failed_transcript "$n" "$log_file"
    if [[ "$keep_on_failure" == 1 ]]; then
      _clear_created "$n"
      warn "leaving '$n' in place for inspection (--keep-on-failure / BOX_KEEP_ON_FAILURE=1)"
      warn "remove when done with: ./box rm '$n' --force"
      die "restore failed; left incomplete destination '$n' for inspection"
    fi
    die "restore failed; attempting cleanup of the incomplete destination"
  fi
  _untrack_guest_temp "$n" "$guest_tmp"
  _clear_created "$n"
  say "Restored and verified. Enter with: ./box enter $n"
}

cmd_import_hermes() {
  local n="${1:?usage: box import-hermes <name> <hermes-backup.zip> [--external NAME]... [--map OLD=NEW]...}"
  local file="${2:?usage: box import-hermes <name> <hermes-backup.zip> [--external NAME]... [--map OLD=NEW]...}"
  local guest_tmp map external already_paused=0 was_running=0 validation external_count archive_external planned_skips
  shift 2
  _validate_name "$n"
  [[ -f "$file" ]] || die "no such Hermes backup: $file"
  _host_preflight import
  # Keep a blank sentinel because macOS Bash 3.2 treats an expanded empty array
  # as unbound under `set -u`.
  local maps=() externals=("")
  [[ -z "${HERMES_IMPORT_PATH_MAP:-}" ]] || maps+=("$HERMES_IMPORT_PATH_MAP")
  while (($#)); do
    case "$1" in
      --external)
        [[ $# -ge 2 ]] || die "expected --external NAME"
        external="$2"
        [[ "$external" =~ ^[A-Za-z0-9._-]+$ && "$external" != . && "$external" != .. ]] ||
          die "invalid external provider name '$external'"
        case "$external" in
          .ssh | .config | workspace | .bashrc | .bash_profile | .profile | .zshrc | .zprofile | .zshenv)
            die "reserved external destination '$external' is never importable" ;;
        esac
        externals+=("$external")
        shift 2
        ;;
      --map)
        [[ $# -ge 2 ]] || die "expected --map OLD=NEW"
        map="$2"
        [[ "$map" == *=* && -n "${map%%=*}" && -n "${map#*=}" ]] || die "invalid path map '$map'"
        maps+=("$map")
        shift 2
        ;;
      *) die "expected --external NAME or --map OLD=NEW" ;;
    esac
  done
  validation="$(python3 "$ROOT/guest/hermes-state" validate-zip "$file")" || die "Hermes backup is invalid or unsafe"
  external_count="$(jq '.external_top_level_entries | length' <<<"$validation")"
  planned_skips="$(jq '.migration_scope.skipped_files' <<<"$validation")"
  if [[ "$planned_skips" != 0 ]]; then
    warn "Native import will intentionally skip ${planned_skips} non-portable or transient file(s):"
    jq -r '.migration_scope.skipped_by_reason | to_entries[] | "  \(.key): \(.value)"' <<<"$validation" >&2
  fi
  if [[ "$external_count" != 0 ]]; then
    say "External provider destinations in archive:"
    jq -r '.external_top_level_entries[] | "  /data/home/agent/" + .' <<<"$validation"
  fi
  while IFS= read -r archive_external; do
    [[ -n "$archive_external" ]] || continue
    case "$archive_external" in
      .ssh | .config | workspace | .bashrc | .bash_profile | .profile | .zshrc | .zprofile | .zshenv)
        die "archive requests reserved external destination '$archive_external'" ;;
    esac
    local approved=0
    for external in "${externals[@]}"; do [[ "$external" == "$archive_external" ]] && approved=1; done
    [[ "$approved" == 1 ]] || die "external provider '$archive_external' is unapproved; re-run with --external '$archive_external'"
  done < <(jq -r '.external_top_level_entries[]' <<<"$validation")
  for external in "${externals[@]}"; do
    [[ -n "$external" ]] || continue
    jq -e --arg name "$external" '.external_top_level_entries | index($name) != null' <<<"$validation" >/dev/null ||
      die "approved external provider '$external' is not present in the archive"
  done
  _acquire_lock "$n"
  _machine_exists "$n" || die "smolvm machine '$n' is missing"
  _machine_running "$n" && was_running=1
  [[ "$was_running" == 1 ]] || _track_stop_after "$n"
  smolvm machine start --name "$n" >/dev/null
  _guest_hb "$n" is-paused >/dev/null 2>&1 && already_paused=1
  _guest_hb "$n" gateway-disable >/dev/null
  _pause_box "$n"
  guest_tmp="/data/home/agent/.config/hermes-box/import-$(date +%Y%m%d-%H%M%S)-$$-${RANDOM}.zip"
  _track_guest_temp "$n" "$guest_tmp"
  smolvm machine exec --name "$n" -- \
    install -d -o agent -g agent -m 0700 /data/home/agent/.config/hermes-box
  smolvm machine cp "$file" "$n:$guest_tmp"
  smolvm machine exec --name "$n" -- chown agent:agent "$guest_tmp"
  smolvm machine exec --name "$n" -- chmod 0600 "$guest_tmp"
  local import_args=(import-zip "$guest_tmp")
  for external in "${externals[@]}"; do
    [[ -n "$external" ]] && import_args+=(--external "$external")
  done
  for map in "${maps[@]}"; do import_args+=(--map "$map"); done
  say "Importing validated Hermes state transactionally into '$n'"
  smolvm machine exec --name "$n" -- \
    setpriv --reuid=agent --regid=agent --init-groups \
    env HOME=/data/home/agent HERMES_HOME=/data/home/agent/.hermes \
    /opt/hermes-box/bin/hermes-state "${import_args[@]}" >/dev/null
  smolvm machine exec --name "$n" -- rm -f -- "$guest_tmp"
  _untrack_guest_temp "$n" "$guest_tmp"
  _guest_hb "$n" verify-state >/dev/null
  if [[ "$already_paused" == 0 ]]; then _resume_box "$n"; fi
  if [[ "$was_running" == 0 ]]; then
    smolvm machine stop --name "$n"
    _clear_stop_after "$n"
  fi
  say "Hermes import verified. Gateway remains disabled; intentional exclusions are recorded in the import manifest. Inspect active paths, acknowledge them, then run the cutover gates."
}

cmd_extract() {
  local file="${1:?usage: box extract <archive.tar.gz.gpg> [dest-dir]}" base dest raw
  [[ -f "$file" ]] || die "no such archive: $file"
  _host_preflight archive
  base="$(basename "$file")"
  base="${base%.tar.gz.gpg}"
  dest="${2:-backups/${base}-extracted}"
  [[ ! -e "$dest" ]] || die "$dest already exists"
  raw="$(mktemp)"
  _track_temp "$raw"
  gpg_dec "$file" >"$raw"
  _validate_archive "$raw" || die "archive is invalid or unsafe"
  mkdir -p "$dest"
  if ! tar xzf "$raw" --no-same-owner -C "$dest"; then
    rm -rf "$dest"
    die "extraction failed"
  fi
  say "Extracted $(find "$dest" -type f | wc -l | tr -d ' ') files -> $dest/"
}

cmd_ls() {
  _host_preflight basic
  if [[ "${1:-}" == --all ]]; then smolvm machine ls; return; fi
  [[ -s "$REG" ]] || { echo "No hermes-box-lite boxes yet. Create one: ./box new <name>"; return; }
  printf '%-16s %-10s %-32s %s\n' BOX STATE EXECUTOR HERMES_API
  local n port api_port _api_guest st url api_url
  while IFS=$'\t' read -r n port api_port _api_guest; do
    [[ -n "$n" ]] || continue
    if st="$(smolvm machine status --name "$n" 2>/dev/null)"; then
      st="${st#*: }"
      st="${st%% *}"
    else
      st=missing
    fi
    url='—'
    api_url='—'
    [[ -n "$port" ]] && url="http://localhost:${port}"
    [[ -n "$api_port" ]] && api_url="http://localhost:${api_port}"
    printf '%-16s %-10s %-32s %s\n' "$n" "$st" "$url" "$api_url"
  done <"$REG"
}

cmd_open() {
  local n="${1:?usage: box open <name>}" port token url
  _validate_name "$n"
  _host_preflight health
  _acquire_lock "$n"
  port="$(_reg_port "$n")"
  [[ -n "$port" ]] || die "'$n' has no exposed Executor host port"
  _machine_running "$n" || die "box '$n' is not running; run './box start $n' before opening Executor"
  _guest_hb "$n" is-paused >/dev/null 2>&1 &&
    die "box '$n' is quiesced; run './box start $n' and 'hb resume' explicitly before opening Executor"
  _guest_hb "$n" up >/dev/null
  token="$(_guest_hb "$n" executor-token)" || die "could not read Executor's local token"
  [[ -n "$token" ]] || die "Executor token is unavailable"
  _wait_mcp_ready "http://127.0.0.1:${port}/mcp" "$token" ||
    die "Executor did not become ready on the forwarded host endpoint"
  url="http://localhost:${port}/?_token=${token}"
  say "Opening authenticated Executor UI at http://localhost:${port}"
  _open_url "$url" ||
    die "could not launch a browser; set BOX_BROWSER to a graphical opener (the authenticated URL is passed directly and never printed)"
}

_open_url() {
  local url="$1" platform
  if [[ -n "${BOX_BROWSER:-}" ]]; then
    command -v "$BOX_BROWSER" >/dev/null 2>&1 || return 1
    "$BOX_BROWSER" "$url" >/dev/null 2>&1
    return
  fi
  platform="$(uname -s)"
  if [[ "$platform" == Darwin ]] && command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1
    return
  elif [[ "$platform" == Linux ]]; then
    if command -v xdg-open >/dev/null 2>&1 && xdg-open "$url" >/dev/null 2>&1; then return; fi
    if command -v gio >/dev/null 2>&1 && gio open "$url" >/dev/null 2>&1; then return; fi
  fi
  return 1
}

cmd_doctor() {
  local n="${1:?usage: box doctor <name>}" port api_port token guest_quiesced=0 gateway_disabled=0
  _validate_name "$n"
  _host_preflight basic
  _acquire_lock "$n"
  port="$(_reg_port "$n")"
  api_port="$(_reg_api_port "$n")"
  _machine_exists "$n" || die "smolvm machine '$n' is missing"
  _guest_hb "$n" is-paused >/dev/null 2>&1 && guest_quiesced=1
  if [[ -n "$api_port" && "$guest_quiesced" == 0 ]]; then
    _guest_hb "$n" gateway-is-disabled >/dev/null 2>&1 && gateway_disabled=1
  fi
  _guest_hb "$n" doctor || die "guest readiness or health check failed for '$n' (doctor never starts or resumes a box)"
  if [[ -n "$port" && "$guest_quiesced" == 0 ]]; then
    _host_preflight health
    token="$(_guest_hb "$n" executor-token)" || die "could not read Executor's local token"
    [[ -n "$token" ]] || die "Executor token is unavailable"
    _wait_mcp_ready "http://127.0.0.1:${port}/mcp" "$token" ||
      die "host Executor MCP health check failed on port $port"
    say "host Executor MCP: healthy on http://localhost:${port}"
  elif [[ "$guest_quiesced" == 1 ]]; then
    say "host Executor MCP: intentionally quiesced"
  else
    say "host Executor MCP: skipped (no exposed host port)"
  fi
  if [[ -n "$api_port" && "$guest_quiesced" == 0 && "$gateway_disabled" == 0 ]]; then
    _host_preflight health
    _hermes_api_healthy "$api_port" || die "host Hermes API health failed on port $api_port (expected 2xx Hermes JSON)"
    say "host Hermes API: healthy on http://localhost:${api_port}"
  elif [[ "$guest_quiesced" == 1 ]]; then
    say "host Hermes API: intentionally quiesced"
  elif [[ "$gateway_disabled" == 1 ]]; then
    say "host Hermes API: intentionally disabled by gateway policy"
  else
    say "host Hermes API: skipped (disabled)"
  fi
  say "doctor passed for '$n'"
}

cmd_repair() {
  local n="${1:?usage: box repair <name>}" already_paused=0
  _validate_name "$n"
  _host_preflight provision
  _acquire_lock "$n"
  _machine_exists "$n" || die "smolvm machine '$n' is missing"
  smolvm machine start --name "$n" >/dev/null
  _guest_hb "$n" is-paused >/dev/null 2>&1 && already_paused=1
  _pause_box "$n"
  _provision_into "$n" full
  if [[ "$already_paused" == 1 ]]; then
    _guest_hb "$n" doctor
    say "repair completed for '$n'; durable quiesce preserved"
  else
    _resume_box "$n"
    _prepare_runtime "$n"
    say "repair completed for '$n'"
  fi
}

cmd_stop() {
  local n="${1:?usage: box stop <name>}"
  _validate_name "$n"
  _host_preflight basic
  _acquire_lock "$n"
  smolvm machine stop --name "$n"
}

cmd_start() {
  local n="${1:?usage: box start <name>}"
  _validate_name "$n"
  _host_preflight basic
  _acquire_lock "$n"
  smolvm machine start --name "$n"
}

cmd_rm() {
  local n="${1:?usage: box rm <name> [--force]}" force="${2:-}" answer latest
  _validate_name "$n"
  _host_preflight basic
  latest="$(find backups -maxdepth 1 -type f -name "${n}-*.tar.gz.gpg" -print 2>/dev/null | sort | tail -1)"
  if [[ -n "$latest" ]]; then say "latest backup: $latest"; else warn "no backup found for '$n'"; fi
  if [[ "$force" != --force ]]; then
    [[ -r /dev/tty ]] || die "refusing non-interactive deletion without --force"
    printf "Type the box name '%s' to delete it permanently: " "$n" >/dev/tty
    read -r answer </dev/tty
    [[ "$answer" == "$n" ]] || die "deletion cancelled"
  fi
  _acquire_lock "$n"
  smolvm machine delete --name "$n" -f
  _acquire_lock registry
  _reg_del "$n"
  _release_lock registry
  say "deleted '$n'"
}

usage() {
  cat <<'EOF'
hermes-box-lite — isolated, portable agent boxes (claude / codex / hermes / executor)

  ./box new <name> [--keep-on-failure]
                               Create, provision, and health-check a fresh box
  ./box enter <name>           Log in as agent and attach tmux 'main'
  ./box ls [--all]             List managed boxes (or every smolvm VM)
  ./box open <name>            Open the authenticated Executor web UI
  ./box doctor <name>          Read-only health check; never starts or resumes a box
  ./box repair <name>          Re-run provisioning and repair managed guest assets
  ./box stop|start <name>      Stop or start an instance
  ./box save <name> [out]      Quiesce, validate, encrypt, and verify /data
  ./box load <file> [name] [--keep-on-failure]
                               Validate first, then build and restore a fresh box
  ./box import-hermes <name> <hermes-backup.zip> [--external NAME]... [--map OLD=NEW]...
                               Transactionally import native Hermes state; gateway stays disabled
  ./box extract <file> [dir]   Validate and extract a backup without a VM
  ./box rm <name> [--force]    Delete after confirmation (or explicit --force)

  Set BOX_PASSPHRASE to skip the GPG prompt. Configuration: box.env
  Set BOX_KEEP_ON_FAILURE=1 (or pass --keep-on-failure to `new`/`load`) to
  skip rollback on a failed `new`/`load` and leave the VM up for inspection.
  A failed `new`/`load` also saves its provisioning transcript under
  backups/.failed/ before any rollback runs.
EOF
}

main() {
  _install_cleanup_traps
  case "${1:-help}" in
    new) shift; cmd_new "$@" ;;
    enter | shell) shift; cmd_enter "$@" ;;
    ls) shift; cmd_ls "$@" ;;
    open) shift; cmd_open "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    repair | provision) shift; cmd_repair "$@" ;;
    stop) shift; cmd_stop "$@" ;;
    start) shift; cmd_start "$@" ;;
    save) shift; cmd_save "$@" ;;
    load) shift; cmd_load "$@" ;;
    import-hermes) shift; cmd_import_hermes "$@" ;;
    extract) shift; cmd_extract "$@" ;;
    rm) shift; cmd_rm "$@" ;;
    help | -h | --help) usage ;;
    *) usage; return 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
