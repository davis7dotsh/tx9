#!/usr/bin/env bash
# boxd — hermes-box-lite on Docker Compose.
#
# One box = one compose project (hbl-<name>) from docker/compose.yaml:
#
#   agent container     linux land: claude/codex/hermes gateway, free rein,
#                       durable /data volume (what save/load archives).
#                       No published ports; reaches Executor only over the
#                       private project network with a bearer token.
#   executor container  Executor daemon alone on its own /data volume.
#                       One published 0.0.0.0 port (LAN/Tailscale) serving
#                       both the dashboard (/) and MCP (/mcp), token-gated.
#
# Both containers run the same image (one `boxd build`); managed tooling is
# image layers, durable state is the volumes, backups are the same encrypted
# tar-of-/data archives ./box produced on smolvm — they interchange.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../box.env
source "$ROOT/box.env"
IMAGE="${BOXD_IMAGE:-hermes-box-lite:latest}"
COMPOSE_FILE="$ROOT/docker/compose.yaml"
ENV_DIR="$ROOT/.boxd"          # per-box compose env (incl. executor token)
LOCK_DIR="$ROOT/.boxd/locks"
_BOX_PASS=""
_TEMP_PATHS=()
_RESUME_BOX=""                 # box paused by us; resumed by EXIT trap on failure

die()  { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
say()  { printf '\033[36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }

_cleanup() {
  local status=$? path
  set +e
  if [[ -n "$_RESUME_BOX" ]]; then
    _guest_hb "$_RESUME_BOX" resume >/dev/null 2>&1 || true
  fi
  for path in "${_TEMP_PATHS[@]:-}"; do [[ -n "$path" ]] && rm -f -- "$path"; done
  exit "$status"
}
trap _cleanup EXIT
trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM

_tmp() { local t; t="$(mktemp)"; _TEMP_PATHS+=("$t"); printf '%s' "$t"; }

_lock() {
  mkdir -p "$LOCK_DIR"
  exec 9>"$LOCK_DIR/$1.lock"
  flock -n 9 || die "another boxd operation holds the '$1' lock"
}

_validate_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,52}$ ]] ||
    die "invalid box name '$1' (1-53 letters, numbers, underscores, dashes; compose project rules)"
}

proj()   { printf 'hbl-%s' "$1"; }
agentc() { printf 'hbl-%s-agent' "$1"; }
execc()  { printf 'hbl-%s-executor' "$1"; }
envf()   { printf '%s/%s.env' "$ENV_DIR" "$1"; }

# All compose invocations for a box go through this so project/file/env are
# always consistent. The env file must exist (created by `new`/`load`).
_compose() {
  local n="$1"; shift
  docker compose -p "$(proj "$n")" -f "$COMPOSE_FILE" --env-file "$(envf "$n")" "$@"
}

_box_exists() { [[ -f "$(envf "$1")" ]] || docker container inspect "$(agentc "$1")" >/dev/null 2>&1; }
_agent_running() {
  [[ "$(docker container inspect -f '{{.State.Running}}' "$(agentc "$1")" 2>/dev/null)" == true ]]
}

_require_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 ||
    die "image '$IMAGE' not found — run: ./docker/boxd build"
}

_write_env_file() {  # $1=name $2=token — chmod 600, contains the bearer token
  mkdir -p "$ENV_DIR"
  local f; f="$(envf "$1")"
  umask 077
  {
    printf 'BOX_NAME=%s\n' "$1"
    printf 'BOXD_IMAGE=%s\n' "$IMAGE"
    printf 'EXECUTOR_MCP_TOKEN=%s\n' "$2"
    printf 'BOX_CPUS=%s\n' "${BOX_CPUS:-4}"
    printf 'BOX_MEM_MIB=%s\n' "${BOX_MEM_MIB:-8192}"
  } >"$f"
  chmod 0600 "$f"
}

# Run hb inside the agent container as the agent user.
_guest_hb() {
  local n="$1"; shift
  docker exec "$(agentc "$n")" \
    runuser -u agent -- env HOME=/data/home/agent \
    EXECUTOR_HOST=executor BOXD_EXECUTOR_TOKEN="$(_token "$n")" \
    bash --noprofile --norc -c \
    '. /etc/profile.d/hermes-box.sh; exec hb "$@"' hb "$@"
}

_token() { sed -n 's/^EXECUTOR_MCP_TOKEN=//p' "$(envf "$1")"; }

_exec_host_port() {  # published host port of the executor service
  { docker port "$(execc "$1")" 4788/tcp 2>/dev/null || true; } | head -1 | awk -F: '{print $NF}'
}

# ---------------------------------------------------------------- passphrase
_resolve_passphrase() {
  local confirm="${1:-}" p1 p2
  [[ -n "$_BOX_PASS" ]] && return
  if [[ -n "${BOX_PASSPHRASE_FILE:-}" ]]; then
    [[ -r "$BOX_PASSPHRASE_FILE" ]] || die "BOX_PASSPHRASE_FILE is not readable"
    IFS= read -r _BOX_PASS <"$BOX_PASSPHRASE_FILE" || true
    [[ -n "$_BOX_PASS" ]] || die "BOX_PASSPHRASE_FILE is empty"
    return
  fi
  if [[ -n "${BOX_PASSPHRASE:-}" ]]; then _BOX_PASS="$BOX_PASSPHRASE"; return; fi
  [[ -r /dev/tty ]] || die "no BOX_PASSPHRASE set and no terminal to prompt on"
  printf 'Passphrase: ' >/dev/tty; read -rs p1 </dev/tty; printf '\n' >/dev/tty
  if [[ "$confirm" == confirm ]]; then
    printf 'Confirm passphrase: ' >/dev/tty; read -rs p2 </dev/tty; printf '\n' >/dev/tty
    [[ "$p1" == "$p2" ]] || die "passphrases do not match"
  fi
  [[ -n "$p1" ]] || die "empty passphrase"
  _BOX_PASS="$p1"
}
gpg_enc() {
  _resolve_passphrase confirm
  gpg --batch --yes --pinentry-mode loopback --passphrase-fd 3 \
    --symmetric --cipher-algo AES256 -o "$1" 3<<<"$_BOX_PASS"
}
gpg_dec() {
  _resolve_passphrase
  gpg --batch --yes --pinentry-mode loopback --passphrase-fd 3 -d "$1" 3<<<"$_BOX_PASS"
}

# Archive safety validator — the production implementation from ./box
# (_validate_archive), lifted verbatim: rejects absolute paths, traversal,
# special files, duplicates, unsafe symlink/hardlink targets, link cycles,
# and paths resolving through links, and requires a real home/agent tree.
_validate_archive() {
  python3 - "$1" <<'PY'
import sys
import tarfile
from pathlib import PurePosixPath

def safe_text(value, label):
    if "\x00" in value or any(ord(char) < 32 or ord(char) == 127 for char in value):
        raise ValueError(f"{label} contains control characters")

def link_parts(value):
    safe_text(value, "archive link target")
    path = PurePosixPath(value)
    if path.is_absolute():
        raise ValueError("archive link target is absolute")
    return [part for part in path.parts if part not in {"", "."}]

def validate_link_target(member, key):
    parts = link_parts(member.linkname)
    if not parts:
        raise ValueError("archive link target is empty")
    resolved = key.split("/")[:-1] if member.issym() else []
    for part in parts:
        if part == "..":
            if not resolved:
                raise ValueError("archive link target lexically escapes extraction root")
            resolved.pop()
        else:
            resolved.append(part)

try:
    with tarfile.open(sys.argv[1], "r:gz") as archive:
        members = archive.getmembers()
        if not members:
            raise ValueError("archive is empty")
        by_name = {}
        for member in members:
            name = member.name
            safe_text(name, "archive path")
            path = PurePosixPath(name)
            if path.is_absolute() or any(part == ".." for part in path.parts):
                raise ValueError("archive path escapes its extraction root")
            parts = tuple(part for part in path.parts if part not in {"", "."})
            key = "/".join(parts)
            if key in by_name:
                raise ValueError(f"archive contains duplicate path: {key or '.'}")
            if not (member.isfile() or member.isdir() or member.issym() or member.islnk()):
                raise ValueError("archive contains a device, FIFO, socket, or unknown special file")
            if not key and not member.isdir():
                raise ValueError("archive root member must be a real directory")
            if member.issym() or member.islnk():
                validate_link_target(member, key)
            by_name[key] = member

        for key in by_name:
            parts = key.split("/") if key else []
            for length in range(1, len(parts)):
                parent = by_name.get("/".join(parts[:length]))
                if parent is not None and (parent.issym() or parent.islnk()):
                    raise ValueError(f"archive member is nested beneath a link: {key}")

        for required in ("home", "home/agent"):
            entry = by_name.get(required)
            if entry is None or not entry.isdir() or entry.issym() or entry.islnk():
                raise ValueError(f"{required} must be a real directory")

        def resolve(key):
            pending = key.split("/") if key else []
            resolved = []
            seen_states = set()
            steps = 0
            while pending:
                steps += 1
                if steps > len(by_name) * 8 + 32:
                    raise ValueError("archive link chain exceeds safety bound")
                state = (tuple(resolved), tuple(pending))
                if state in seen_states:
                    raise ValueError("archive link cycle detected")
                seen_states.add(state)
                part = pending.pop(0)
                if part in {"", "."}:
                    continue
                if part == "..":
                    if not resolved:
                        raise ValueError("archive link target escapes extraction root")
                    resolved.pop()
                    continue
                candidate = "/".join((*resolved, part))
                entry = by_name.get(candidate)
                if entry is not None and (entry.issym() or entry.islnk()):
                    base = candidate.split("/")[:-1] if entry.issym() else []
                    pending = base + link_parts(entry.linkname) + pending
                    resolved = []
                    continue
                if pending and (entry is None or not entry.isdir()):
                    raise ValueError(f"archive path resolves through missing or non-directory member: {candidate}")
                resolved.append(part)
            final = "/".join(resolved)
            entry = by_name.get(final)
            if entry is None:
                raise ValueError(f"archive link resolves to missing member: {final or '.'}")
            return entry

        for key, member in by_name.items():
            if not key:
                continue
            parent = key.rpartition("/")[0]
            if parent and not resolve(parent).isdir():
                raise ValueError(f"archive member parent is not a directory: {key}")
            if member.issym() or member.islnk():
                target = resolve(key)
                if member.islnk() and not target.isfile():
                    raise ValueError("archive hardlink does not resolve to a regular file")
except (OSError, tarfile.TarError, ValueError) as error:
    print(f"unsafe archive: {error}", file=sys.stderr)
    raise SystemExit(1)
PY
}

# ------------------------------------------------------------------ commands
cmd_build() {
  say "Building $IMAGE from $ROOT (provision runs at build time)"
  docker build -t "$IMAGE" -f "$ROOT/docker/Dockerfile" "$ROOT"
  say "Built $IMAGE"
}

_prepare_runtime() {  # same post-create guarantee as ./box: up, wire, doctor
  local n="$1" attempt
  # hb-workload's reconcile loop may hold daemon locks right after boot;
  # `hb up` waits 5s per flock, so allow the box up to ~90s to converge.
  for attempt in 1 2 3 4 5 6; do
    _guest_hb "$n" up >/dev/null 2>&1 && break
    [[ "$attempt" == 6 ]] && { _guest_hb "$n" up >/dev/null; return 1; }
    sleep 15
  done
  _guest_hb "$n" wire-once >/dev/null || return 1
  _guest_hb "$n" doctor
}

_destroy() {  # containers + volumes + network + env file, best-effort
  _compose "$1" down -v --timeout 10 >/dev/null 2>&1 || true
  rm -f "$(envf "$1")"
}

cmd_new() {
  local n="${1:?usage: boxd new <name>}" token
  _validate_name "$n"
  _require_image
  _lock "$n"
  ! _box_exists "$n" || die "box '$n' already exists"
  say "Creating box '$n' (agent + executor containers, private network)"
  token="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  _write_env_file "$n" "$token"
  if ! _compose "$n" up -d --quiet-pull 2>/dev/null; then
    _destroy "$n"; die "compose up failed; box removed"
  fi
  say "Preparing runtime (executor reachability, MCP wiring, doctor)"
  if ! _prepare_runtime "$n"; then
    warn "runtime preparation failed; leaving '$n' in place for inspection"
    die "box '$n' created but unhealthy — inspect with: ./docker/boxd enter $n (or rm it)"
  fi
  say "Ready. Enter with: ./docker/boxd enter $n"
  local ep; ep="$(_exec_host_port "$n")"
  [[ -n "$ep" ]] && say "Executor dashboard + MCP (token-gated): http://${BOXD_URL_HOST:-siva.davis7.space}:${ep}/"
  say "Authenticate inside, then ./docker/boxd save $n to capture the state."
}

cmd_enter() {
  local n="${1:?usage: boxd enter <name>}"
  _validate_name "$n"
  _box_exists "$n" || die "box '$n' does not exist"
  _agent_running "$n" || _compose "$n" start >/dev/null
  exec docker exec -it -u agent \
    -e HOME=/data/home/agent -e USER=agent -e LOGNAME=agent -e SHELL=/bin/bash \
    -e EXECUTOR_HOST=executor -e "BOXD_EXECUTOR_TOKEN=$(_token "$n")" \
    -w /data/home/agent "$(agentc "$n")" bash -l
}

cmd_ls() {
  local rows name state n ep
  rows="$(docker ps -a --filter "label=hermes-box-lite" --filter "name=-agent$" \
    --format $'{{.Names}}\t{{.State}}')" || die "could not query the Docker daemon"
  printf '%-16s %-10s %s\n' BOX STATE 'EXECUTOR (dashboard+MCP)'
  while IFS=$'\t' read -r name state; do
    [[ -n "$name" ]] || continue
    n="${name#hbl-}"; n="${n%-agent}"
    ep="$(_exec_host_port "$n")"
    printf '%-16s %-10s %s\n' "$n" "$state" "${ep:+http://${BOXD_URL_HOST:-siva.davis7.space}:$ep/}"
  done <<<"$rows"
}

cmd_doctor() {
  local n="${1:?usage: boxd doctor <name>}" ep
  _validate_name "$n"
  _box_exists "$n" || die "box '$n' does not exist"
  _agent_running "$n" || die "box '$n' is not running"
  _guest_hb "$n" doctor || die "guest doctor failed for '$n'"
  ep="$(_exec_host_port "$n")"
  if [[ -n "$ep" ]]; then
    # Right after `start`, the executor daemon needs a few seconds; retry
    # briefly so doctor doesn't flake in the boot window.
    local attempt ok=0
    for attempt in 1 2 3 4 5 6; do
      curl -sf --connect-timeout 3 -o /dev/null "http://127.0.0.1:${ep}/" && { ok=1; break; }
      sleep 3
    done
    [[ "$ok" == 1 ]] || die "executor dashboard unreachable on published host port $ep"
    say "host executor endpoint: healthy on port $ep"
  fi
  say "doctor passed for '$n'"
}

cmd_stop()  { _validate_name "${1:?usage: boxd stop <name>}";  _lock "$1"; _compose "$1" stop --timeout 20 >/dev/null; say "stopped '$1'"; }
cmd_start() { _validate_name "${1:?usage: boxd start <name>}"; _lock "$1"; _compose "$1" start >/dev/null; say "started '$1'"; }

cmd_save() {
  local n="${1:?usage: boxd save <name> [out.tar.gz.gpg]}" ts out raw encrypted
  _validate_name "$n"
  _lock "$n"
  _agent_running "$n" || die "box '$n' is not running"
  ts="$(date +%Y%m%d-%H%M%S)"
  out="${2:-backups/${n}-${ts}.tar.gz.gpg}"
  [[ ! -e "$out" ]] || die "refusing to overwrite existing backup: $out"
  mkdir -p "$(dirname "$out")"
  raw="$(_tmp)"
  encrypted="$(mktemp "${out}.tmp.XXXXXX")"
  _TEMP_PATHS+=("$encrypted")

  say "Quiescing the Hermes gateway inside '$n' (executor container unaffected)"
  if ! _guest_hb "$n" is-paused >/dev/null 2>&1; then
    _RESUME_BOX="$n"   # EXIT trap resumes on any failure past this point
    _guest_hb "$n" pause
  fi
  _guest_hb "$n" verify-state --checkpoint >/dev/null
  _guest_hb "$n" write-manifest
  say "Archiving agent /data"
  docker exec "$(agentc "$n")" bash -c \
    'set -euo pipefail; umask 077; sync
     tar czf - -C /data \
       --exclude="./home/agent/.config/hermes-box/quiesced" \
       --exclude="./home/agent/.codex/tmp" \
       --exclude="./home/agent/.hermes/tmp" \
       --exclude="*/node_modules" --exclude="*/.venv" --exclude="*/venv" \
       --exclude="*/__pycache__" --exclude="*/.cache" \
       --exclude="*.pyc" --exclude="*.pyo" \
       --exclude="*/.hermes/*.db-wal" --exclude="*/.hermes/*.db-shm" \
       --exclude="*/.hermes/*.db-journal" \
       --exclude="*/gateway.pid" --exclude="*/cron.pid" --exclude="*/gateway.lock" \
       --exclude="*/processes.json" .' >"$raw"
  _validate_archive "$raw" || die "generated archive failed validation"
  if [[ "$_RESUME_BOX" == "$n" ]]; then
    _guest_hb "$n" resume
    _RESUME_BOX=""
  fi

  say "Encrypting and verifying backup"
  rm -f "$encrypted"
  gpg_enc "$encrypted" <"$raw"
  gpg_dec "$encrypted" | tar tzf - >/dev/null || die "encrypted backup verification failed"
  ln "$encrypted" "$out" 2>/dev/null || die "backup destination appeared during save: $out"
  rm -f "$encrypted"
  say "Saved and verified $(du -h "$out" | cut -f1) -> $out"
}

cmd_load() {
  local file="${1:?usage: boxd load <archive.tar.gz.gpg> [name]}" n="${2:-restored}" raw token
  [[ -f "$file" ]] || die "no such archive: $file"
  _validate_name "$n"
  _require_image
  _lock "$n"
  ! _box_exists "$n" || die "box '$n' already exists"
  raw="$(_tmp)"
  say "Decrypting and validating archive before creating anything"
  gpg_dec "$file" >"$raw"
  _validate_archive "$raw" || die "archive is invalid or unsafe"

  say "Creating box and restoring agent /data"
  token="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  _write_env_file "$n" "$token"
  # `create` materializes the project volumes without starting services, so a
  # throwaway container can populate agent /data before anything runs.
  if ! _compose "$n" create --quiet-pull >/dev/null 2>&1; then
    _destroy "$n"; die "compose create failed; box removed"
  fi
  # Extract into a staging dir on the fresh volume, assert permission
  # topology, verify Hermes state, then promote. Restore-safety markers
  # re-arm quiesce + gateway-disable (single-writer rule).
  if ! docker run --rm -i -v "$(proj "$n")_agent-data:/data" --entrypoint bash "$IMAGE" -c '
    set -euo pipefail
    find /data -mindepth 1 -delete
    stage=/data/.hb-restore-stage
    mkdir -m 0700 "$stage"
    tar xzf - --no-same-owner -C "$stage"
    test -d "$stage/home/agent"
    chown root:root "$stage" "$stage/home"
    chmod 0711 "$stage" "$stage/home"
    chown -R agent:agent "$stage/home/agent" "$stage/logs" 2>/dev/null || true
    mkdir -p "$stage/home/agent/.config/hermes-box"
    touch "$stage/home/agent/.config/hermes-box/quiesced" \
          "$stage/home/agent/.config/hermes-box/gateway-disabled" \
          "$stage/home/agent/.config/hermes-box/gateway-policy-initialized"
    chown -R agent:agent "$stage/home/agent/.config/hermes-box"
    runuser -u agent -- env HOME=/data/home/agent \
      /opt/hermes-box/bin/hermes-state verify --home "$stage/home/agent/.hermes" >/dev/null
    shopt -s dotglob
    mv "$stage"/* /data/
    rmdir "$stage"
    chown root:root /data && chmod 0711 /data
  ' <"$raw"; then
    _destroy "$n"; die "restore failed; box removed"
  fi

  say "Starting restored box '$n' (quiesced, gateway disabled)"
  if ! _compose "$n" up -d >/dev/null 2>&1; then
    _destroy "$n"; die "compose up failed after restore; box removed"
  fi
  _guest_hb "$n" verify-state >/dev/null || warn "post-start verify-state failed — inspect before resuming"
  say "Restored. Enter with: ./docker/boxd enter $n — then 'hb resume' and the gateway-enable gates."
}

cmd_rm() {
  local n="${1:?usage: boxd rm <name> [--force]}" force="${2:-}" answer latest
  _validate_name "$n"
  latest="$(find backups -maxdepth 1 -type f -name "${n}-*.tar.gz.gpg" -print 2>/dev/null | sort | tail -1)"
  if [[ -n "$latest" ]]; then say "latest backup: $latest"; else warn "no backup found for '$n'"; fi
  if [[ "$force" != --force ]]; then
    [[ -r /dev/tty ]] || die "refusing non-interactive deletion without --force"
    printf "Type the box name '%s' to delete its containers AND volumes permanently: " "$n" >/dev/tty
    read -r answer </dev/tty
    [[ "$answer" == "$n" ]] || die "deletion cancelled"
  fi
  _lock "$n"
  _compose "$n" down -v --timeout 20 >/dev/null 2>&1 ||
    die "compose down failed for '$n' — inspect with: docker compose -p $(proj "$n") ps"
  rm -f "$(envf "$n")" "$LOCK_DIR/$n.lock"
  say "deleted '$n'"
}

usage() {
  cat <<'EOF'
boxd — hermes-box-lite on Docker Compose (agent + executor per box)

  ./docker/boxd build            Build the shared image (runs provision.sh once)
  ./docker/boxd new <name>       Create a box: 2 containers + 2 volumes + network
  ./docker/boxd enter <name>     Shell into the agent container (tmux 'main')
  ./docker/boxd ls               List boxes and executor dashboard URLs
  ./docker/boxd doctor <name>    In-box doctor + host executor endpoint check
  ./docker/boxd stop|start <n>   Stop / start both containers (volumes persist)
  ./docker/boxd save <n> [out]   Quiesce gateway + archive agent /data (encrypted;
                                 same format as ./box save — archives interchange)
  ./docker/boxd load <file> [n]  Restore an archive into a fresh box (gateway disabled)
  ./docker/boxd rm <name>        Delete containers AND volumes (confirmation required)

  BOX_PASSPHRASE / BOX_PASSPHRASE_FILE as before. BOXD_IMAGE overrides the image.
  The executor's published port serves the dashboard (/) and MCP (/mcp) on all
  host interfaces (LAN + Tailscale); the bearer token in .boxd/<name>.env is
  the gate. The agent container has no published ports.
EOF
}

main() {
  command -v docker >/dev/null 2>&1 || die "docker not found on PATH"
  docker compose version >/dev/null 2>&1 || die "docker compose v2 plugin not found"
  case "${1:-help}" in
    build)  shift; cmd_build "$@" ;;
    new)    shift; cmd_new "$@" ;;
    enter)  shift; cmd_enter "$@" ;;
    ls)     shift; cmd_ls "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    stop)   shift; cmd_stop "$@" ;;
    start)  shift; cmd_start "$@" ;;
    save)   shift; cmd_save "$@" ;;
    load)   shift; cmd_load "$@" ;;
    rm)     shift; cmd_rm "$@" ;;
    help|-h|--help) usage ;;
    *) usage; return 1 ;;
  esac
}
main "$@"
