#!/usr/bin/env python3
"""Hermes state validation and transactional native-backup import."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import sqlite3
import stat
import struct
import sys
import tempfile
import time
import zipfile
from pathlib import Path, PurePosixPath


EXCLUDED_DIRS = {
    "__pycache__", ".git", "node_modules", "backups",
    "checkpoints", ".venv", "venv", "site-packages", ".cache", ".tox",
    ".nox", ".pytest_cache", ".mypy_cache", ".ruff_cache",
}
EXCLUDED_SUFFIXES = (".pyc", ".pyo", ".db-wal", ".db-shm", ".db-journal")
RUNTIME_NAMES = {
    "gateway_state.json", "gateway.pid", "cron.pid", "gateway.lock",
    "processes.json",
}
SECRET_NAMES = {".env", "auth.json", "state.db"}
EXTERNAL_SECRET_SUFFIXES = {".json", ".env", ".conf", ".key", ".pem"}
MARKERS = {"config.yaml", ".env", "state.db"}
MAX_UNCOMPRESSED = 100 * 1024**3
RESERVED_EXTERNAL = {
    ".ssh", ".config", "workspace", ".bashrc", ".bash_profile", ".profile",
    ".zshrc", ".zprofile", ".zshenv",
}
THIN_MACHO_MAGICS = {
    b"\xfe\xed\xfa\xce": ">",
    b"\xce\xfa\xed\xfe": "<",
    b"\xfe\xed\xfa\xcf": ">",
    b"\xcf\xfa\xed\xfe": "<",
}
FAT_MACHO_MAGICS = {
    b"\xca\xfe\xba\xbe": (">", 20),
    b"\xbe\xba\xfe\xca": ("<", 20),
    b"\xca\xfe\xba\xbf": (">", 32),
    b"\xbf\xba\xfe\xca": ("<", 32),
}
FAT_MACHO_CPU_TYPES = {
    7, 12, 18,  # i386, arm, ppc
    0x01000007, 0x0100000C, 0x01000012,  # x86_64, arm64, ppc64
    0x0200000C,  # arm64_32
}
MACHO_SLICE_HEADER_PROBE_LIMIT = 1024 * 1024
MIGRATION_POLICY = {
    "version": 1,
    "root_transient_paths": ["tmp/"],
    "mach_o": "skip files with a thin Mach-O magic or a structurally valid universal Mach-O header",
    "archive_handling": "read-only; the source ZIP is never rewritten",
}


def _safe_relative(name: str) -> PurePosixPath:
    if "\x00" in name or "\\" in name:
        raise ValueError(f"unsafe archive path: {name!r}")
    path = PurePosixPath(name)
    if path.is_absolute() or any(part in {"", ".", ".."} for part in path.parts):
        raise ValueError(f"unsafe archive path: {name!r}")
    return path


def _zip_layout(zf: zipfile.ZipFile) -> tuple[str, list[zipfile.ZipInfo]]:
    files: list[zipfile.ZipInfo] = []
    total = 0
    for info in zf.infolist():
        _safe_relative(info.filename.rstrip("/"))
        mode = (info.external_attr >> 16) & 0o170000
        if mode == stat.S_IFLNK:
            raise ValueError(f"symlink entry is not allowed: {info.filename}")
        if info.is_dir():
            continue
        if mode not in {0, stat.S_IFREG}:
            raise ValueError(f"non-regular entry is not allowed: {info.filename}")
        total += info.file_size
        if total > MAX_UNCOMPRESSED:
            raise ValueError("archive expands beyond the 100 GiB safety limit")
        files.append(info)
    if not files:
        raise ValueError("archive is empty")
    first = {PurePosixPath(info.filename).parts[0] for info in files}
    prefix = next(iter(first)) + "/" if len(first) == 1 and next(iter(first)) in {".hermes", "hermes"} else ""
    found = set()
    for info in files:
        relative = PurePosixPath(
            info.filename[len(prefix):] if prefix and info.filename.startswith(prefix) else info.filename
        )
        if relative.parts[0] != "_external":
            found.add(relative.name)
    if not found.intersection(MARKERS):
        raise ValueError("archive is not a native Hermes backup (no config, env, or state database)")
    normalized: set[str] = set()
    for info in files:
        relative = _safe_relative(
            info.filename[len(prefix):] if prefix and info.filename.startswith(prefix) else info.filename
        )
        key = str(relative)
        if key in normalized:
            raise ValueError(f"duplicate normalized archive path: {key}")
        normalized.add(key)
    return prefix, files


def validate_zip(path: Path) -> dict[str, object]:
    if not path.is_file() or not zipfile.is_zipfile(path):
        raise ValueError(f"not a valid ZIP file: {path}")
    with zipfile.ZipFile(path) as zf:
        prefix, files = _zip_layout(zf)
        entries = _classify_entries(zf, prefix, files)
        _require_importable_marker(entries)
        external = sorted({
            rel.parts[1]
            for _info, rel, external_entry, reason in entries
            if external_entry and reason is None and len(rel.parts) > 1
        })
        return {
            "archive": str(path),
            "files": len(files),
            "uncompressed_bytes": sum(info.file_size for info in files),
            "prefix": prefix,
            "external_top_level_entries": external,
            "migration_policy": MIGRATION_POLICY,
            "migration_scope": _accounting(entries),
        }


def _path_skip_reason(rel: PurePosixPath) -> str | None:
    parts = rel.parts
    if not parts:
        return "empty_path"
    if parts[0] == "tmp":
        return "root_tmp"
    if rel.name in RUNTIME_NAMES:
        return "runtime_state"
    if rel.name.endswith(EXCLUDED_SUFFIXES):
        return "excluded_suffix"
    if parts[0] == "hermes-agent":
        return "hermes_agent_checkout"
    if any(part in EXCLUDED_DIRS for part in parts):
        return "excluded_directory"
    return None


def _is_mach_o(zf: zipfile.ZipFile, info: zipfile.ZipInfo) -> bool:
    with zf.open(info) as source:
        header = source.read(8)
        magic = header[:4]
        if magic in THIN_MACHO_MAGICS:
            return True
        fat_layout = FAT_MACHO_MAGICS.get(magic)
        if fat_layout is None or len(header) != 8:
            return False
        endian, architecture_size = fat_layout
        architecture_count = struct.unpack(f"{endian}I", header[4:])[0]
        if architecture_count < 1 or architecture_count > 64:
            return False
        table_size = architecture_count * architecture_size
        data_start = len(header) + table_size
        if data_start > info.file_size:
            return False
        table = source.read(table_size)
        if len(table) != table_size:
            return False
        slices: list[tuple[int, int, int]] = []
        for offset in range(0, table_size, architecture_size):
            architecture = table[offset:offset + architecture_size]
            if architecture_size == 20:
                cpu_type, _subtype, slice_offset, slice_size, alignment = struct.unpack(
                    f"{endian}IIIII", architecture
                )
            else:
                cpu_type, _subtype, slice_offset, slice_size, alignment, _reserved = struct.unpack(
                    f"{endian}IIQQII", architecture
                )
            if (
                cpu_type not in FAT_MACHO_CPU_TYPES
                or slice_size < 8
                or slice_offset < data_start
                or slice_offset + slice_size > info.file_size
                or alignment > 63
            ):
                return False
            slices.append((slice_offset, slice_size, cpu_type))
        slices.sort()
        previous_end = data_start
        for slice_offset, slice_size, _cpu_type in slices:
            if slice_offset < previous_end:
                return False
            previous_end = slice_offset + slice_size
        probe_limit = min(info.file_size, MACHO_SLICE_HEADER_PROBE_LIMIT)
        for slice_offset, _slice_size, cpu_type in slices:
            if slice_offset + 8 > probe_limit:
                break
            source.seek(slice_offset)
            slice_header = source.read(8)
            thin_endian = THIN_MACHO_MAGICS.get(slice_header[:4])
            if thin_endian is None or len(slice_header) != 8:
                return False
            if struct.unpack(f"{thin_endian}I", slice_header[4:])[0] != cpu_type:
                return False
        return True


def _classify_entries(
    zf: zipfile.ZipFile,
    prefix: str,
    files: list[zipfile.ZipInfo],
) -> list[tuple[zipfile.ZipInfo, PurePosixPath, bool, str | None]]:
    entries: list[tuple[zipfile.ZipInfo, PurePosixPath, bool, str | None]] = []
    for info in files:
        name = info.filename[len(prefix):] if prefix and info.filename.startswith(prefix) else info.filename
        rel = _safe_relative(name)
        external = rel.parts[0] == "_external"
        if external and len(rel.parts) == 1:
            reason = "external_root_entry"
        elif not external:
            reason = _path_skip_reason(rel)
        else:
            reason = None
        if reason is None and _is_mach_o(zf, info):
            reason = "mach_o_binary"
        entries.append((info, rel, external, reason))
    return entries


def _require_importable_marker(
    entries: list[tuple[zipfile.ZipInfo, PurePosixPath, bool, str | None]],
) -> None:
    if not any(
        len(rel.parts) == 1
        and rel.name in MARKERS
        and not external
        and reason is None
        for _info, rel, external, reason in entries
    ):
        raise ValueError(
            "archive has no importable canonical root Hermes marker "
            "(config.yaml, .env, or state.db)"
        )


def _accounting(
    entries: list[tuple[zipfile.ZipInfo, PurePosixPath, bool, str | None]],
) -> dict[str, object]:
    result: dict[str, object] = {
        "archive_files": len(entries),
        "archive_bytes": sum(info.file_size for info, _rel, _external, _reason in entries),
        "hermes_files": 0,
        "hermes_bytes": 0,
        "external_files": 0,
        "external_bytes": 0,
        "skipped_files": 0,
        "skipped_bytes": 0,
    }
    skipped_entries: list[dict[str, object]] = []
    skipped_by_reason: dict[str, int] = {}
    for info, rel, external, reason in entries:
        if reason is not None:
            result["skipped_files"] = int(result["skipped_files"]) + 1
            result["skipped_bytes"] = int(result["skipped_bytes"]) + info.file_size
            skipped_by_reason[reason] = skipped_by_reason.get(reason, 0) + 1
            skipped_entries.append({"path": str(rel), "reason": reason, "bytes": info.file_size})
            continue
        category = "external" if external else "hermes"
        result[f"{category}_files"] = int(result[f"{category}_files"]) + 1
        result[f"{category}_bytes"] = int(result[f"{category}_bytes"]) + info.file_size
    result["normalized_files"] = int(result["hermes_files"]) + int(result["external_files"])
    result["normalized_bytes"] = int(result["hermes_bytes"]) + int(result["external_bytes"])
    result["skipped_by_reason"] = dict(sorted(skipped_by_reason.items()))
    result["skipped_entries"] = sorted(skipped_entries, key=lambda item: str(item["path"]))
    return result


def _table_count(conn: sqlite3.Connection, table: str) -> int | None:
    row = conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (table,)
    ).fetchone()
    if not row:
        return None
    return int(conn.execute(f'SELECT COUNT(*) FROM "{table}"').fetchone()[0])


def inspect_home(home: Path, checkpoint: bool = False) -> dict[str, object]:
    databases: list[dict[str, object]] = []
    for db in sorted(home.rglob("*.db")) if home.exists() else []:
        if db.is_symlink() or any(part in EXCLUDED_DIRS for part in db.relative_to(home).parts):
            continue
        uri = f"{db.absolute().as_uri()}?mode={'rw' if checkpoint else 'ro'}"
        conn = sqlite3.connect(uri, uri=True, timeout=30)
        try:
            if checkpoint:
                conn.execute("PRAGMA busy_timeout=200")
                checkpoint_result = (1, 0, 0)
                for _attempt in range(5):
                    row = conn.execute("PRAGMA wal_checkpoint(TRUNCATE)").fetchone()
                    checkpoint_result = tuple(int(value) for value in row) if row else (1, 0, 0)
                    busy, log_frames, checkpointed_frames = checkpoint_result
                    if busy == 0 and log_frames == checkpointed_frames:
                        break
                    time.sleep(0.2)
                busy, log_frames, checkpointed_frames = checkpoint_result
                if busy != 0 or log_frames != checkpointed_frames:
                    raise ValueError(
                        f"SQLite checkpoint incomplete for {db}: "
                        f"busy={busy}, log={log_frames}, checkpointed={checkpointed_frames}"
                    )
            integrity = str(conn.execute("PRAGMA integrity_check").fetchone()[0])
            if integrity != "ok":
                raise ValueError(f"SQLite integrity failed for {db}: {integrity}")
            entry: dict[str, object] = {
                "path": str(db.relative_to(home)),
                "integrity": integrity,
                "user_version": int(conn.execute("PRAGMA user_version").fetchone()[0]),
            }
            for table in ("sessions", "messages"):
                count = _table_count(conn, table)
                if count is not None:
                    entry[table] = count
            databases.append(entry)
        finally:
            conn.close()

    cron_jobs = 0
    active_cron_jobs = 0
    for cron_file in sorted(home.rglob("jobs.json")) if home.exists() else []:
        if cron_file.parent.name != "cron":
            continue
        data = json.loads(cron_file.read_text())
        jobs = data if isinstance(data, list) else data.get("jobs", []) if isinstance(data, dict) else []
        cron_jobs += len(jobs)
        active_cron_jobs += sum(
            1 for job in jobs if isinstance(job, dict) and job.get("enabled", job.get("active", True))
        )

    gateway_states: list[dict[str, str]] = []
    for state_file in sorted(home.rglob("gateway_state.json")) if home.exists() else []:
        try:
            data = json.loads(state_file.read_text())
            gateway_states.append({
                "path": str(state_file.relative_to(home)),
                "state": str(data.get("gateway_state", data.get("state", "unknown"))),
            })
        except (OSError, ValueError):
            gateway_states.append({"path": str(state_file.relative_to(home)), "state": "invalid"})

    env_file = home / ".env"
    discord_configured = False
    if env_file.is_file():
        for line in env_file.read_text(errors="replace").splitlines():
            if line.startswith("DISCORD_BOT_TOKEN=") and line.partition("=")[2].strip().strip("'\""):
                discord_configured = True
                break

    def count_area(name: str) -> int:
        return sum(
            1
            for directory in home.rglob(name)
            if directory.is_dir()
            for candidate in directory.rglob("*")
            if candidate.is_file()
        ) if home.exists() else 0

    return {
        "home": str(home),
        "exists": home.is_dir(),
        "databases": databases,
        "inventory": {
            "session_files": count_area("sessions"),
            "memory_files": count_area("memories"),
            "skill_files": count_area("skills"),
            "cron_jobs": cron_jobs,
            "active_cron_jobs": active_cron_jobs,
        },
        "gateway_states": gateway_states,
        "discord_configured": discord_configured,
    }


def _extract(
    zf: zipfile.ZipFile,
    stage: Path,
    external_stage: Path,
    prefix: str,
    files: list[zipfile.ZipInfo],
    approved_external: set[str],
) -> dict[str, object]:
    entries = _classify_entries(zf, prefix, files)
    # Recheck viability against this exact open ZIP snapshot. The host-side
    # preview may refer to an archive replaced before import reopened it.
    _require_importable_marker(entries)
    accounting = _accounting(entries)
    total_written = 0
    for info, rel, external, reason in entries:
        if reason is not None:
            continue
        if external:
            if rel.parts[1] not in approved_external:
                raise ValueError(f"unapproved external provider entry: {rel.parts[1]}")
            target = external_stage.joinpath(*rel.parts[1:])
        else:
            target = stage.joinpath(*rel.parts)
        target.parent.mkdir(parents=True, exist_ok=True)
        # Track actual decompressed bytes rather than trusting info.file_size
        # (attacker-controlled central-directory metadata, gated only on the
        # *declared* total in _zip_layout) — a crafted stream can produce far
        # more output than it declares.
        with zf.open(info) as source, target.open("wb") as destination:
            while True:
                chunk = source.read(1024 * 1024)
                if not chunk:
                    break
                total_written += len(chunk)
                if total_written > MAX_UNCOMPRESSED:
                    raise ValueError(
                        f"archive expands beyond the 100 GiB safety limit "
                        f"(actual bytes exceeded the declared total at {info.filename})"
                    )
                destination.write(chunk)
        secret = target.name in SECRET_NAMES or target.suffix.lower() in EXTERNAL_SECRET_SUFFIXES
        archived_mode = (info.external_attr >> 16) & 0o777
        executable_path = any(part in {"hooks", "scripts"} for part in rel.parts[:-1])
        safe_mode = archived_mode if executable_path and archived_mode else 0o644
        target.chmod(0o600 if secret else safe_mode & 0o777)
    if approved_external:
        for directory in external_stage.rglob("*"):
            if directory.is_dir():
                directory.chmod(0o700)
    return accounting


def _active_rewrite_files(home: Path) -> list[Path]:
    selected: list[Path] = []
    for path in home.rglob("*"):
        if not path.is_file() or path.is_symlink():
            continue
        rel = path.relative_to(home)
        if path.name in {"config.yaml", ".env"} or (path.name == "jobs.json" and path.parent.name == "cron"):
            selected.append(path)
        elif any(part in {"hooks", "scripts"} for part in rel.parts[:-1]):
            selected.append(path)
    return selected


def _rewrite_active(home: Path, mappings: list[tuple[str, str]]) -> list[str]:
    changed: list[str] = []
    for path in _active_rewrite_files(home):
        try:
            text = path.read_text()
        except UnicodeDecodeError:
            continue
        rewritten = text
        for source, destination in sorted(mappings, key=lambda item: len(item[0]), reverse=True):
            rewritten = rewritten.replace(source, destination)
        if rewritten != text:
            path.write_text(rewritten)
            path.chmod(0o600 if path.name == ".env" else path.stat().st_mode & 0o777)
            changed.append(str(path.relative_to(home)))
    return changed


def _secure_external(target: Path) -> None:
    if target.is_dir():
        target.chmod(0o700)
        for item in target.rglob("*"):
            if item.is_dir():
                item.chmod(0o700)
            elif item.name in SECRET_NAMES or item.suffix.lower() in EXTERNAL_SECRET_SUFFIXES:
                item.chmod(0o600)
    elif target.name in SECRET_NAMES or target.suffix.lower() in EXTERNAL_SECRET_SUFFIXES:
        target.chmod(0o600)


def import_zip(
    path: Path,
    home: Path,
    mappings: list[tuple[str, str]],
    manifest: Path,
    approved_external: set[str],
) -> dict[str, object]:
    archive_report = validate_zip(path)
    archive_external = set(archive_report["external_top_level_entries"])
    if archive_external & RESERVED_EXTERNAL:
        raise ValueError(
            "archive contains reserved external destinations: "
            + ", ".join(sorted(archive_external & RESERVED_EXTERNAL))
        )
    if approved_external & RESERVED_EXTERNAL:
        raise ValueError(
            "reserved external destinations are never importable: "
            + ", ".join(sorted(approved_external & RESERVED_EXTERNAL))
        )
    unapproved = archive_external - approved_external
    unexpected = approved_external - archive_external
    if unapproved:
        raise ValueError("unapproved external provider entries: " + ", ".join(sorted(unapproved)))
    if unexpected:
        raise ValueError("approved external entries not present: " + ", ".join(sorted(unexpected)))
    parent = home.parent
    parent.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix=f".{home.name}.import-", dir=parent))
    external_stage = Path(tempfile.mkdtemp(prefix=".hermes-external-import-", dir=parent))
    external_merge = Path(tempfile.mkdtemp(prefix=".hermes-external-merge-", dir=parent))
    external_previous = Path(tempfile.mkdtemp(prefix=".hermes-external-previous-", dir=parent))
    previous = parent / f".{home.name}.previous-{os.getpid()}-{int(time.time())}"
    swapped = False
    external_swaps: list[tuple[Path, Path | None]] = []
    try:
        with zipfile.ZipFile(path) as zf:
            prefix, files = _zip_layout(zf)
            accounting = _extract(zf, stage, external_stage, prefix, files, approved_external)
        source_report = inspect_home(stage)
        source_report["external_files"] = sum(1 for item in external_stage.rglob("*") if item.is_file())
        rewritten = _rewrite_active(stage, mappings)
        rewritten.extend(f"_external/{item}" for item in _rewrite_active(external_stage, mappings))
        inspect_home(stage)
        if home.exists():
            home.rename(previous)
        stage.rename(home)
        swapped = True
        for source in sorted(external_stage.iterdir()):
            target = home.parent / source.name
            if target == home or source.name in {".", ".."}:
                raise ValueError(f"unsafe external Hermes state target: {target}")
            if target.is_symlink() or (
                target.is_dir() and any(item.is_symlink() for item in target.rglob("*"))
            ):
                raise ValueError(f"existing external provider tree contains symlinks: {target}")
            candidate = source
            if source.is_dir() and target.is_dir():
                candidate = external_merge / source.name
                shutil.copytree(target, candidate, symlinks=True)
                shutil.copytree(source, candidate, dirs_exist_ok=True)
            old: Path | None = None
            if target.exists() or target.is_symlink():
                old = external_previous / source.name
                target.rename(old)
            external_swaps.append((target, old))
            candidate.rename(target)
            _secure_external(target)
        destination_report = inspect_home(home)
        destination_report["external_files"] = sum(
            1 for target, _ in external_swaps
            for item in ([target] if target.is_file() else target.rglob("*"))
            if item.is_file()
        )
        result = {
            "format": 2,
            "status": "completed_with_skips" if accounting["skipped_files"] else "completed",
            "imported_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "source_archive": str(path),
            "source": source_report,
            "destination": destination_report,
            "active_files_rewritten": rewritten,
            "path_maps": [{"from": source, "to": destination} for source, destination in mappings],
            "external_state_imported": bool(external_swaps),
            "external_top_level_entries": [target.name for target, _ in external_swaps],
            "external_approved": sorted(approved_external),
            "migration_policy": MIGRATION_POLICY,
            "accounting": accounting,
            "active_paths_reviewed": False,
            "gateway_enabled": False,
        }
        manifest.parent.mkdir(parents=True, exist_ok=True)
        tmp_manifest = manifest.with_name(f"{manifest.name}.tmp.{os.getpid()}")
        tmp_manifest.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
        tmp_manifest.chmod(0o600)
        tmp_manifest.replace(manifest)
        if previous.exists():
            shutil.rmtree(previous)
        shutil.rmtree(external_previous)
        return result
    except Exception:
        for target, old in reversed(external_swaps):
            if target.is_dir() and not target.is_symlink():
                shutil.rmtree(target)
            elif target.exists() or target.is_symlink():
                target.unlink()
            if old is not None and old.exists():
                old.rename(target)
        if swapped and home.exists():
            shutil.rmtree(home)
        if previous.exists():
            previous.rename(home)
        raise
    finally:
        if stage.exists():
            shutil.rmtree(stage)
        for temporary in (external_stage, external_merge, external_previous):
            if temporary.exists():
                shutil.rmtree(temporary)


def acknowledge_paths(manifest: Path) -> dict[str, object]:
    if not manifest.is_file():
        raise ValueError(f"import manifest not found: {manifest}")
    data = json.loads(manifest.read_text())
    data["active_paths_reviewed"] = True
    data["active_paths_reviewed_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    temporary = manifest.with_name(f"{manifest.name}.tmp.{os.getpid()}")
    temporary.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    temporary.chmod(0o600)
    temporary.replace(manifest)
    return data


def _nonnegative_integer(value: object) -> bool:
    return type(value) is int and value >= 0


def _format2_scope_accounted(accounting: object) -> bool:
    if not isinstance(accounting, dict):
        return False
    numeric_fields = (
        "archive_files", "archive_bytes", "hermes_files", "hermes_bytes",
        "external_files", "external_bytes", "skipped_files", "skipped_bytes",
        "normalized_files", "normalized_bytes",
    )
    if not all(_nonnegative_integer(accounting.get(field)) for field in numeric_fields):
        return False
    skipped_entries = accounting.get("skipped_entries")
    skipped_by_reason = accounting.get("skipped_by_reason")
    if not isinstance(skipped_entries, list) or not isinstance(skipped_by_reason, dict):
        return False
    if not all(
        isinstance(reason, str)
        and bool(reason)
        and _nonnegative_integer(count)
        for reason, count in skipped_by_reason.items()
    ):
        return False
    grouped_reasons: dict[str, int] = {}
    skipped_paths: list[str] = []
    skipped_byte_total = 0
    for entry in skipped_entries:
        if not isinstance(entry, dict) or set(entry) != {"path", "reason", "bytes"}:
            return False
        path = entry.get("path")
        reason = entry.get("reason")
        byte_count = entry.get("bytes")
        if (
            not isinstance(path, str)
            or not path
            or not isinstance(reason, str)
            or not reason
            or not _nonnegative_integer(byte_count)
        ):
            return False
        skipped_paths.append(path)
        skipped_byte_total += byte_count
        grouped_reasons[reason] = grouped_reasons.get(reason, 0) + 1
    if skipped_paths != sorted(set(skipped_paths)):
        return False
    return (
        accounting["skipped_files"] == len(skipped_entries)
        and accounting["skipped_bytes"] == skipped_byte_total
        and skipped_by_reason == dict(sorted(grouped_reasons.items()))
        and accounting["normalized_files"]
        == accounting["hermes_files"] + accounting["external_files"]
        and accounting["archive_files"]
        == accounting["normalized_files"] + accounting["skipped_files"]
        and accounting["normalized_bytes"]
        == accounting["hermes_bytes"] + accounting["external_bytes"]
        and accounting["archive_bytes"]
        == accounting["normalized_bytes"] + accounting["skipped_bytes"]
    )


def cutover_check(manifest: Path, home: Path) -> dict[str, object]:
    if not manifest.is_file():
        raise ValueError(f"import manifest not found: {manifest}")
    data = json.loads(manifest.read_text())
    source = data.get("source", {})
    destination = data.get("destination", {})
    accounting = data.get("accounting", {})
    if not isinstance(accounting, dict):
        accounting = {}
    manifest_format = data.get("format", 1)
    has_v2_scope = "migration_policy" in data or any(
        field in accounting
        for field in (
            "archive_bytes", "hermes_bytes", "external_bytes", "skipped_bytes",
            "normalized_files", "normalized_bytes", "skipped_entries",
            "skipped_by_reason",
        )
    )
    # Format 1 predates normalized byte/path accounting. Keep its established
    # archive-accounted gate while requiring the stronger invariant for v2+.
    migration_scope_accounted = (
        type(manifest_format) is int
        and (
            (manifest_format < 2 and not has_v2_scope)
            or _format2_scope_accounted(accounting)
        )
    )
    current = inspect_home(home)
    gates = {
        "database_integrity": bool(current.get("databases"))
        and all(item.get("integrity") == "ok" for item in current.get("databases", [])),
        "database_baseline_match": source.get("databases") == destination.get("databases"),
        "inventory_baseline_match": source.get("inventory") == destination.get("inventory"),
        "current_database_matches_source": current.get("databases") == source.get("databases"),
        "current_database_matches_import": current.get("databases") == destination.get("databases"),
        "current_inventory_matches_source": current.get("inventory") == source.get("inventory"),
        "current_inventory_matches_import": current.get("inventory") == destination.get("inventory"),
        "discord_configured": current.get("discord_configured") is True,
        "active_paths_reviewed": data.get("active_paths_reviewed") is True,
        "archive_accounted": accounting.get("archive_files")
        == accounting.get("hermes_files", 0)
        + accounting.get("external_files", 0)
        + accounting.get("skipped_files", 0),
        "migration_scope_accounted": migration_scope_accounted,
    }
    result = {"ready": all(gates.values()), "gates": gates, "current": current}
    if not result["ready"]:
        failed = ", ".join(name for name, passed in gates.items() if not passed)
        raise ValueError(f"cutover gates failed: {failed}")
    return result


def _mapping(value: str) -> tuple[str, str]:
    source, separator, destination = value.partition("=")
    if not separator or not source or not destination:
        raise argparse.ArgumentTypeError("path maps must be OLD=NEW")
    return source, destination


def main() -> None:
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)
    validate = subparsers.add_parser("validate-zip")
    validate.add_argument("archive", type=Path)
    verify = subparsers.add_parser("verify")
    verify.add_argument("--home", type=Path, default=Path(os.environ.get("HERMES_HOME", Path.home() / ".hermes")))
    verify.add_argument("--checkpoint", action="store_true")
    importer = subparsers.add_parser("import-zip")
    importer.add_argument("archive", type=Path)
    importer.add_argument("--home", type=Path, default=Path(os.environ.get("HERMES_HOME", Path.home() / ".hermes")))
    importer.add_argument("--manifest", type=Path, default=Path.home() / ".config/hermes-box/import-manifest.json")
    importer.add_argument("--map", action="append", type=_mapping, default=[])
    importer.add_argument("--external", action="append", default=[])
    acknowledge = subparsers.add_parser("acknowledge-paths")
    acknowledge.add_argument("--manifest", type=Path, default=Path.home() / ".config/hermes-box/import-manifest.json")
    cutover = subparsers.add_parser("cutover-check")
    cutover.add_argument("--manifest", type=Path, default=Path.home() / ".config/hermes-box/import-manifest.json")
    cutover.add_argument("--home", type=Path, default=Path(os.environ.get("HERMES_HOME", Path.home() / ".hermes")))
    args = parser.parse_args()
    if args.command == "validate-zip":
        result = validate_zip(args.archive)
    elif args.command == "verify":
        result = inspect_home(args.home, args.checkpoint)
    elif args.command == "import-zip":
        result = import_zip(args.archive, args.home, args.map, args.manifest, set(args.external))
        if result["accounting"]["skipped_files"]:
            print(
                "warning: import completed with "
                f"{result['accounting']['skipped_files']} intentionally skipped file(s); "
                "inspect accounting.skipped_entries in the import manifest",
                file=sys.stderr,
            )
    elif args.command == "acknowledge-paths":
        result = acknowledge_paths(args.manifest)
    else:
        result = cutover_check(args.manifest, args.home)
    print(json.dumps(result, indent=2, sort_keys=True))


if __name__ == "__main__":
    main()
