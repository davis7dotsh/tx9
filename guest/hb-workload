#!/usr/bin/env bash
# Persistent box service — smolvm runs this as the box's workload on every start
# (as the agent user), and it stays alive for the box's lifetime. It keeps the
# Executor and the Hermes gateway healthy, plus optional host-forward bridges.
# (executor's own 0.0.0.0 mode is ephemeral, and exec-started daemons don't
# survive — so this boot-context loop is what makes host access durable.)
set -u
PORT="${1:-4788}"
HERMES_BRIDGE_PORT="${2:-0}"
# shellcheck disable=SC1091
[ -f /etc/profile.d/hermes-box.sh ] && . /etc/profile.d/hermes-box.sh
QUIESCE_FILE="$HOME/.config/hermes-box/quiesced"
LEGACY_QUIESCE_FILE="${HB_LEGACY_QUIESCE_FILE:-/tmp/hermes-box-executor-paused}"
GATEWAY_DISABLED="$HOME/.config/hermes-box/gateway-disabled"
GATEWAY_RELOAD_REQUESTS="$HOME/.config/hermes-box/gateway-reload-requests"
EXECUTOR_TARGET_PORT="${EXECUTOR_PORT:-4788}"
HERMES_TARGET_PORT="${HERMES_API_PORT:-8642}"
LOGS="${HB_WORKLOAD_LOGS:-/data/logs}"
BOX_ENV="${HB_BOX_ENV:-/etc/hermes-box.env}"

_exec_up() { (exec 3<>"/dev/tcp/127.0.0.1/$EXECUTOR_TARGET_PORT") 2>/dev/null && { exec 3>&-; return 0; }; return 1; }
_api_up() { (exec 3<>"/dev/tcp/127.0.0.1/$HERMES_TARGET_PORT") 2>/dev/null && { exec 3>&-; return 0; }; return 1; }

_wait_api_ready() {
  local _
  for _ in 1 2 3 4 5; do
    _api_up && return 0
    sleep 1
  done
  return 1
}

_stop_bridge() {
  local listener="$1" _
  pkill -TERM -f "socat TCP-LISTEN:$listener," 2>/dev/null || true
  for _ in 1 2 3 4 5; do
    ! pgrep -f "socat TCP-LISTEN:$listener," >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  pkill -KILL -f "socat TCP-LISTEN:$listener," 2>/dev/null || true
}

_stop_api_bridge() { [ "$HERMES_BRIDGE_PORT" = 0 ] || _stop_bridge "$HERMES_BRIDGE_PORT"; }

_stop_executor_bridge() { [ "$PORT" = 4788 ] || _stop_bridge "$PORT"; }

_spawn_logged() {
  local source="$1" logfile="$2"
  shift 2
  if command -v tx9-logs >/dev/null 2>&1; then
    tx9-logs capture --source "$source" --log-dir "$LOGS" -- "$@" &
  else
    "$@" >>"$logfile" 2>&1 &
  fi
}

_gateway_reload_pending() {
  [ -d "$GATEWAY_RELOAD_REQUESTS" ] &&
    [ -n "$(find "$GATEWAY_RELOAD_REQUESTS" -maxdepth 1 -type f -name 'request.*' -print -quit)" ]
}

_migrate_legacy_quiesce() {
  [ -e "$LEGACY_QUIESCE_FILE" ] || return 0
  mkdir -p "$(dirname "$QUIESCE_FILE")" || return 1
  chmod 0700 "$(dirname "$QUIESCE_FILE")" || return 1
  touch "$QUIESCE_FILE" || return 1
  rm -f "$LEGACY_QUIESCE_FILE"
}

_refresh_targets() {
  local previous_executor="$EXECUTOR_TARGET_PORT" previous_api="$HERMES_TARGET_PORT"
  EXECUTOR_PORT=4788
  HERMES_API_PORT=8642
  # Managed root-owned repair output; refresh it because this workload outlives repair.
  # shellcheck disable=SC1090
  [ ! -r "$BOX_ENV" ] || . "$BOX_ENV"
  EXECUTOR_TARGET_PORT="${EXECUTOR_PORT:-4788}"
  HERMES_TARGET_PORT="${HERMES_API_PORT:-8642}"
  if [ "$previous_executor" != "$EXECUTOR_TARGET_PORT" ]; then _stop_executor_bridge; fi
  if [ "$previous_api" != "$HERMES_TARGET_PORT" ]; then _stop_api_bridge; fi
}

reconcile_once() {
  local reconciled=0
  _refresh_targets
  if [ -e "$LEGACY_QUIESCE_FILE" ] && ! _migrate_legacy_quiesce; then
    _stop_executor_bridge
    _stop_api_bridge
    return
  fi
  if [ -e "$QUIESCE_FILE" ] || [ -e "$LEGACY_QUIESCE_FILE" ]; then
    _stop_executor_bridge
    _stop_api_bridge
    return
  fi
  if _gateway_reload_pending &&
     ! hb gateway-reload-if-requested; then
    _stop_api_bridge
    return
  fi
  # The container entrypoint captures this process's stdout/stderr into the
  # compatible workload.log and structured agent.jsonl. Leaving hb output on
  # its original stream also keeps it visible in `docker logs`.
  if hb reconcile; then reconciled=1; fi
  # socat bridge for host access (only when a distinct port was assigned)
  if [ "$PORT" != "4788" ] && command -v socat >/dev/null 2>&1 && _exec_up \
     && ! pgrep -f "socat TCP-LISTEN:$PORT," >/dev/null 2>&1; then
    _spawn_logged socat "$LOGS/socat.log" socat \
      "TCP-LISTEN:$PORT,bind=0.0.0.0,fork,reuseaddr" "TCP:127.0.0.1:$EXECUTOR_TARGET_PORT"
  fi
  if [ "$HERMES_BRIDGE_PORT" != 0 ] && [ "$reconciled" = 1 ] && [ ! -e "$GATEWAY_DISABLED" ] \
     && command -v socat >/dev/null 2>&1 && _wait_api_ready; then
    if ! pgrep -f "socat TCP-LISTEN:$HERMES_BRIDGE_PORT," >/dev/null 2>&1; then
      _spawn_logged hermes-api-socat "$LOGS/hermes-api-socat.log" socat \
        "TCP-LISTEN:$HERMES_BRIDGE_PORT,bind=0.0.0.0,fork,reuseaddr" \
        "TCP:127.0.0.1:$HERMES_TARGET_PORT"
    fi
  else
    _stop_api_bridge
  fi
}

main() {
  mkdir -p "$LOGS"
  while true; do
    reconcile_once
    [[ "${HB_WORKLOAD_ONCE:-0}" != 1 ]] || break
    sleep 20
  done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main; fi
