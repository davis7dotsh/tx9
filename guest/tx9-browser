#!/usr/bin/env python3
"""Image-owned Chromium + agent-browser health, seed, and versions helper."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import uuid
from dataclasses import dataclass
from pathlib import Path


HB = Path("/opt/hermes-box")
DEFAULT_CLI = HB / "bin" / "agent-browser"
DEFAULT_CHROME = HB / "bin" / "chrome"
DEFAULT_FIXTURE = HB / "browser" / "fixtures" / "smoke.html"
DEFAULT_MANIFEST = HB / "browser" / "manifest.json"
IMAGE_CLI = (
    HB / "bin" / "agent-browser",
    HB / "browser" / "bin" / "agent-browser",
)
PROBE_PREFIX = f"tx9-browser-probe-{os.getpid()}-{uuid.uuid4().hex[:8]}"
PROBE_DIR = Path("/tmp") / PROBE_PREFIX
SESSION = PROBE_PREFIX
FIXTURE_MARKER = "TX9_BROWSER_FIXTURE_OK"
HTTPS_SMOKE_URL = "https://example.com"
CLI_TIMEOUT = 45
BROWSER_YAML_KEYS = ("backend", "cloud_provider", "cdp_url", "engine")
BROWSER_ENV_KEYS = (
    "AGENT_BROWSER_ENGINE",
    "BROWSER_CDP_URL",
    "CAMOFOX_URL",
    "BROWSER_USE_API_KEY",
    "BROWSERBASE_API_KEY",
    "FIRECRAWL_API_KEY",
)
HEALTH_CODES = (
    "ok",
    "cli_missing",
    "browser_missing",
    "libs_missing",
    "launch_failed",
    "navigate_failed",
)


@dataclass(frozen=True)
class Paths:
    cli: Path
    chrome: Path
    ldd: Path | None
    fixture: Path


@dataclass(frozen=True)
class Health:
    code: str
    detail: str = ""
    shadow: str | None = None

    @property
    def ok(self) -> bool:
        return self.code == "ok"


def _executable(path: Path) -> bool:
    try:
        return path.is_file() and os.access(path, os.X_OK)
    except OSError:
        return False


def _path_shadow() -> str | None:
    found = shutil.which("agent-browser")
    if found is None:
        return None
    found_path = Path(found)
    try:
        found_real = found_path.resolve()
    except OSError:
        found_real = found_path
    for image in IMAGE_CLI:
        try:
            image_real = image.resolve() if image.exists() else image
        except OSError:
            image_real = image
        if found_path == image or found_real == image_real:
            return None
    return found


def _with_shadow(health: Health, shadow: str | None) -> Health:
    return Health(health.code, health.detail, shadow)


def check_cli(paths: Paths) -> Health:
    if _executable(paths.cli):
        return Health("ok")
    return Health("cli_missing", f"agent-browser is not an executable file: {paths.cli}")


def check_browser(paths: Paths) -> Health:
    if _executable(paths.chrome):
        return Health("ok")
    return Health("browser_missing", f"chrome is not an executable file: {paths.chrome}")


def check_libs(paths: Paths) -> Health:
    if paths.ldd is None:
        return Health("ok")
    if not _executable(paths.ldd):
        return Health("libs_missing", f"ldd is not an executable file: {paths.ldd}")
    try:
        chrome = paths.chrome.resolve()
    except OSError:
        chrome = paths.chrome
    try:
        proc = subprocess.run(
            [str(paths.ldd), str(chrome)],
            capture_output=True,
            text=True,
            timeout=15,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return Health("libs_missing", f"ldd failed: {exc}")
    missing = [
        line.strip()
        for line in (proc.stdout + "\n" + proc.stderr).splitlines()
        if "not found" in line
    ]
    if missing:
        return Health("libs_missing", "; ".join(missing))
    if proc.returncode != 0:
        return Health("libs_missing", "ldd failed to inspect chrome")
    return Health("ok")


def _cli(paths: Paths, args: list[str], timeout: float = CLI_TIMEOUT) -> subprocess.CompletedProcess[str]:
    PROBE_DIR.mkdir(mode=0o700, exist_ok=True)
    # A health check owns its browser and ignores user session/CDP configuration.
    env = {key: value for key, value in os.environ.items() if not key.startswith("AGENT_BROWSER_")}
    env["HOME"] = str(PROBE_DIR)
    env["AGENT_BROWSER_SOCKET_DIR"] = str(PROBE_DIR)
    cmd = [
        str(paths.cli),
        "--executable-path",
        str(paths.chrome),
        "--session",
        SESSION,
        "--profile",
        str(PROBE_DIR / "profile"),
        *args,
    ]
    # Files avoid an inherited stdout pipe keeping timeout recovery blocked.
    with tempfile.TemporaryFile(mode="w+") as out, tempfile.TemporaryFile(mode="w+") as err:
        with subprocess.Popen(cmd, stdout=out, stderr=err, env=env, cwd=PROBE_DIR,
                              start_new_session=True) as proc:
            try:
                proc.wait(timeout=timeout)
            except BaseException:
                # Interrupts must also reap the command before Popen waits on exit.
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                raise
            out.seek(0)
            err.seek(0)
            return subprocess.CompletedProcess(cmd, proc.returncode, out.read(), err.read())


def _cli_close(paths: Paths) -> None:
    try:
        _cli(paths, ["close"], timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return


def _cli_output(proc: subprocess.CompletedProcess[str]) -> str:
    return f"{proc.stdout}\n{proc.stderr}"


def check_launch_and_navigate(paths: Paths) -> Health:
    target = paths.fixture.resolve().as_uri()
    try:
        opened = _cli(paths, ["open", target])
    except subprocess.TimeoutExpired:
        _cli_close(paths)
        return Health("launch_failed", f"agent-browser open timed out on {target}")
    except OSError as exc:
        return Health("launch_failed", str(exc))
    if opened.returncode != 0:
        _cli_close(paths)
        detail = _cli_output(opened).strip() or f"exit {opened.returncode}"
        return Health("launch_failed", detail)
    try:
        snap = _cli(paths, ["snapshot"], timeout=30)
    except (OSError, subprocess.TimeoutExpired) as exc:
        _cli_close(paths)
        return Health("navigate_failed", f"snapshot failed: {exc}")
    if snap.returncode != 0 or FIXTURE_MARKER not in snap.stdout:
        _cli_close(paths)
        return Health("navigate_failed", "fixture marker missing from snapshot")
    if os.environ.get("TX9_BROWSER_HTTPS_SMOKE") == "1":
        try:
            https = _cli(paths, ["open", HTTPS_SMOKE_URL])
        except (OSError, subprocess.TimeoutExpired) as exc:
            _cli_close(paths)
            return Health("navigate_failed", f"{HTTPS_SMOKE_URL} failed: {exc}")
        page = _cli_output(https)
        if https.returncode != 0:
            _cli_close(paths)
            return Health("navigate_failed", page.strip() or f"{HTTPS_SMOKE_URL} failed")
        if "example" not in page.lower() and "<html" not in page.lower():
            try:
                title = _cli(paths, ["get", "title"], timeout=15)
            except (OSError, subprocess.TimeoutExpired):
                title = None
            text = _cli_output(title) if title is not None else ""
            if "example" not in f"{page}\n{text}".lower():
                _cli_close(paths)
                return Health("navigate_failed", f"{HTTPS_SMOKE_URL} produced no document")
    _cli_close(paths)
    return Health("ok")


def evaluate(paths: Paths) -> Health:
    shadow = _path_shadow()
    for step in (check_cli, check_browser, check_libs, check_launch_and_navigate):
        result = step(paths)
        if result.code != "ok":
            return _with_shadow(result, shadow)
    return Health("ok", "", shadow)


def _emit_shadow(health: Health, dest=None) -> None:
    if not health.shadow:
        return
    print(f"info browser PATH shadow: {health.shadow}", file=dest or sys.stderr)


def _default_hermes_home() -> Path:
    env = os.environ.get("HERMES_HOME")
    if env:
        return Path(env)
    return Path.home() / ".hermes"


def _env_has_browser_key(text: str) -> bool:
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].strip()
        key = line.split("=", 1)[0].strip()
        if key in BROWSER_ENV_KEYS:
            return True
    return False


def seed_config(config: Path, env_path: Path) -> str:
    import yaml

    config = config.resolve()
    config_text = config.read_text(encoding="utf-8") if config.is_file() else ""
    env_text = env_path.read_text(encoding="utf-8") if env_path.is_file() else ""
    if _env_has_browser_key(env_text) or any(key in os.environ for key in BROWSER_ENV_KEYS):
        return "preserved"
    try:
        data = yaml.safe_load(config_text)
    except yaml.YAMLError as exc:
        # Parser diagnostics may contain secrets from the configuration.
        raise ValueError("invalid YAML; configuration left unchanged") from exc
    if data is None:
        data = {}
    if not isinstance(data, dict):
        raise ValueError("configuration must be a YAML mapping")
    browser = data.get("browser")
    if browser is None:
        browser = {}
    if not isinstance(browser, dict):
        raise ValueError("browser configuration must be a YAML mapping")
    if any(key in browser or f"browser.{key}" in data for key in BROWSER_YAML_KEYS):
        return "preserved"
    data["browser"] = {**browser, "backend": "off", "cloud_provider": "local", "engine": "chrome"}
    config.parent.mkdir(parents=True, exist_ok=True)
    mode = config.stat().st_mode & 0o777 if config.exists() else 0o600
    fd, name = tempfile.mkstemp(prefix=".browser-config-", dir=config.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            os.fchmod(handle.fileno(), mode)
            yaml.safe_dump(data, handle, sort_keys=False, allow_unicode=True)
        os.replace(name, config)
    finally:
        Path(name).unlink(missing_ok=True)
    return "seeded"


def read_versions(manifest: Path) -> dict[str, str]:
    missing = {
        "agent_browser": "missing",
        "chrome": "missing",
        "arch": "missing",
    }
    if not manifest.is_file():
        return missing
    try:
        data = json.loads(manifest.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return missing
    if not isinstance(data, dict):
        return missing
    return {
        "agent_browser": str(data.get("agent_browser_version") or data.get("agent_browser") or "missing"),
        "chrome": str(data.get("chrome_version") or data.get("chrome") or "missing"),
        "arch": str(data.get("arch") or "missing"),
    }


def _proc_cmdline(pid: int) -> str | None:
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return None
    return raw.replace(b"\x00", b" ").decode("utf-8", "replace")


def probe_pids() -> list[int]:
    found: list[int] = []
    try:
        entries = Path("/proc").iterdir()
    except OSError:
        return found
    self_pid = os.getpid()
    for entry in entries:
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        if pid == self_pid:
            continue
        cmdline = _proc_cmdline(pid)
        if cmdline is None:
            continue
        owned = PROBE_PREFIX in cmdline
        if not owned:
            try:
                # agent-browser detaches with no session in argv; its private
                # socket directory still identifies it and its descendants.
                marker = f"AGENT_BROWSER_SOCKET_DIR={PROBE_DIR}".encode()
                owned = marker in (entry / "environ").read_bytes().split(b"\0")
            except OSError:
                pass
        if owned:
            found.append(pid)
    return found


def cleanup_probes() -> int:
    pids = probe_pids()
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            continue
        except PermissionError:
            continue
    deadline = time.monotonic() + 1.0
    while time.monotonic() < deadline and probe_pids():
        time.sleep(0.05)
    for pid in probe_pids():
        try:
            os.kill(pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            continue
    return 0


def _paths_from_args(args: argparse.Namespace) -> Paths:
    ldd: Path | None
    if args.ldd is not None:
        ldd = args.ldd
    else:
        found = shutil.which("ldd")
        ldd = Path(found) if found else None
    return Paths(
        cli=args.cli or DEFAULT_CLI,
        chrome=args.chrome or DEFAULT_CHROME,
        ldd=ldd,
        fixture=args.fixture or DEFAULT_FIXTURE,
    )


def _add_probe_flags(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--cli", type=Path)
    parser.add_argument("--chrome", type=Path)
    parser.add_argument("--ldd", type=Path)
    parser.add_argument("--fixture", type=Path)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="tx9-browser")
    sub = parser.add_subparsers(dest="command", required=True)
    health = sub.add_parser("health")
    health.add_argument("--json", action="store_true")
    _add_probe_flags(health)
    doctor = sub.add_parser("doctor")
    _add_probe_flags(doctor)
    seed = sub.add_parser("seed-config")
    seed.add_argument("--config", type=Path)
    seed.add_argument("--env", type=Path)
    versions = sub.add_parser("versions")
    versions.add_argument("--json", action="store_true")
    verify = sub.add_parser("verify")
    _add_probe_flags(verify)
    sub.add_parser("cleanup")
    return parser


def cmd_health(args: argparse.Namespace) -> int:
    health = evaluate(_paths_from_args(args))
    _emit_shadow(health)
    if args.json:
        print(json.dumps({
            "code": health.code,
            "detail": health.detail,
            "shadow": health.shadow,
        }, sort_keys=True))
    else:
        print(health.code)
    return 0 if health.ok else 1


def cmd_doctor(args: argparse.Namespace) -> int:
    health = evaluate(_paths_from_args(args))
    if health.ok:
        print("ok   browser")
        _emit_shadow(health, dest=sys.stdout)
        return 0
    print(f"FAIL browser ({health.code})", file=sys.stderr)
    if health.detail:
        print(health.detail, file=sys.stderr)
    _emit_shadow(health)
    return 1


def cmd_verify(args: argparse.Namespace) -> int:
    health = evaluate(_paths_from_args(args))
    _emit_shadow(health)
    return 0 if health.ok else 1


def cmd_seed(args: argparse.Namespace) -> int:
    home = _default_hermes_home()
    config = args.config or (home / "config.yaml")
    env_path = args.env or (home / ".env")
    try:
        print(seed_config(config, env_path))
    except (OSError, ValueError, ImportError) as exc:
        print(f"seed-config failed: {exc}", file=sys.stderr)
        return 1
    return 0


def cmd_versions(args: argparse.Namespace) -> int:
    versions = read_versions(DEFAULT_MANIFEST)
    if args.json:
        print(json.dumps(versions, sort_keys=True))
        return 0
    print(f"agent-browser: {versions['agent_browser']}")
    print(f"chrome:        {versions['chrome']}")
    return 0


def main() -> int:
    args = build_parser().parse_args()
    if args.command == "health":
        return cmd_health(args)
    if args.command == "doctor":
        return cmd_doctor(args)
    if args.command == "seed-config":
        return cmd_seed(args)
    if args.command == "versions":
        return cmd_versions(args)
    if args.command == "verify":
        return cmd_verify(args)
    if args.command == "cleanup":
        return cleanup_probes()
    return 2


if __name__ == "__main__":
    def interrupted(signum, _frame):
        raise SystemExit(128 + signum)

    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGINT, interrupted)
    try:
        sys.exit(main())
    finally:
        cleanup_probes()
        shutil.rmtree(PROBE_DIR, ignore_errors=True)
