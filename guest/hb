#!/usr/bin/env bash
# hb — in-box control for durable layout, Hermes, Executor, and diagnostics.
set -uo pipefail
# shellcheck disable=SC1091
[ -f /etc/profile.d/hermes-box.sh ] && . /etc/profile.d/hermes-box.sh
# shellcheck source=guest/lib-mcp.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib-mcp.sh"

DATA="${HB_DATA:-/data}"
AGENT_HOME="$DATA/home/agent"
LOGS="$DATA/logs"
STATE_DIR="$AGENT_HOME/.config/hermes-box"
QUIESCE_FILE="$STATE_DIR/quiesced"
LEGACY_QUIESCE_FILE="${HB_LEGACY_QUIESCE_FILE:-/tmp/hermes-box-executor-paused}"
GATEWAY_DISABLED="$STATE_DIR/gateway-disabled"
GATEWAY_POLICY="$STATE_DIR/gateway-policy-initialized"
GATEWAY_PID="$STATE_DIR/gateway.pid"
GATEWAY_LOCK="$STATE_DIR/gateway.lock"
EXECUTOR_LOCK="$STATE_DIR/executor.lock"
WIRE_VERSION=http-v1
WIRED="$AGENT_HOME/.hermes-box-wired"
TOKEN_FILE="$AGENT_HOME/.executor/server-control/auth.json"
TOKEN_ENV="$AGENT_HOME/.config/hermes-box/executor-mcp.env"

init() {
  local managed=(
    "$AGENT_HOME" "$AGENT_HOME/.claude" "$AGENT_HOME/.codex" "$AGENT_HOME/.hermes"
    "$AGENT_HOME/workspace" "$AGENT_HOME/.config" "$AGENT_HOME/.config/hermes-box"
    "$AGENT_HOME/.local" "$AGENT_HOME/.local/share" "$AGENT_HOME/.local/state" "$LOGS"
  )
  mkdir -p "${managed[@]}"
  id agent >/dev/null 2>&1 && chown agent:agent "${managed[@]}" 2>/dev/null || true
  if [[ -e "$LEGACY_QUIESCE_FILE" ]]; then
    touch "$QUIESCE_FILE" || return 1
    rm -f "$LEGACY_QUIESCE_FILE" || return 1
  fi
  if [[ ! -e "$GATEWAY_POLICY" ]]; then
    touch "$GATEWAY_DISABLED" "$GATEWAY_POLICY"
  fi
  # Provisioning runs init as root, which would leave the policy markers
  # root-owned; later agent-run gateway_disable/gateway_enable must be able
  # to recreate and remove them.
  id agent >/dev/null 2>&1 && chown agent:agent "$GATEWAY_DISABLED" "$GATEWAY_POLICY" 2>/dev/null || true
}

_port_open() {
  (exec 3<>"/dev/tcp/127.0.0.1/${EXECUTOR_PORT:-4788}") 2>/dev/null && { exec 3>&-; return 0; }
  return 1
}

_port_closed() { ! _port_open; }

_wait_port() {
  local expected="$1" attempt
  for ((attempt = 0; attempt < 30; attempt++)); do
    if [[ "$expected" == open ]] && _port_open; then return 0; fi
    if [[ "$expected" == closed ]] && ! _port_open; then return 0; fi
    sleep 1
  done
  return 1
}

# flock-based lock generalized for any check-then-spawn daemon start (gateway,
# executor, and future daemons share this rather than each hand-rolling its
# own copy). Without it, hb-workload's 20s reconcile loop and a host-initiated
# `hb up` can both observe "not running" and both spawn the same daemon.
#
# flock over a hand-rolled mkdir+pid-file lock specifically because stale-lock
# recovery is the hard part to get right with plain filesystem primitives: an
# earlier mkdir/rm-rf-based version of this (and an mv-based "fix" to it) both
# had a confirmed TOCTOU window where two contenders racing to reclaim the
# same dead-owner lock could end up both "holding" it. flock is kernel-
# enforced and auto-releases the instant every fd referencing it closes, with
# no manual dead-owner detection needed — verified directly: 8 trials of 10
# processes racing a pre-seeded "stale" lock all converged on exactly one
# winner, and killing -9 a holder mid-section let the next contender acquire
# in ~0.2s instead of the 5s timeout.
declare -A _DAEMON_LOCK_FDS

_acquire_daemon_lock() {
  local lock="$1"
  local fd
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  exec {fd}>"$lock"
  if ! flock -w 5 "$fd"; then
    eval "exec ${fd}>&-"
    return 1
  fi
  _DAEMON_LOCK_FDS["$lock"]="$fd"
}

_release_daemon_lock() {
  local lock="$1"
  local fd="${_DAEMON_LOCK_FDS[$lock]:-}"
  [[ -n "$fd" ]] || return 0
  flock -u "$fd" 2>/dev/null || true
  eval "exec ${fd}>&-" 2>/dev/null || true
  unset "_DAEMON_LOCK_FDS[$lock]"
}

# A long-lived daemon spawned with a lock fd still open would inherit it and
# hold the underlying flock open for its entire lifetime (file description
# locks survive fork; the kernel only auto-releases once every fd referring
# to it, across every process, is closed) — wedging every future acquire
# attempt until that daemon exits. Verified: without this, a spawned `sleep`
# standing in for a daemon kept the lock held after the spawning shell
# explicitly released it; with it, a fresh acquire attempt succeeded in
# milliseconds right after spawning.
_spawn_without_lock_fd() {
  local lock="$1" logfile="$2"
  shift 2
  local fd="${_DAEMON_LOCK_FDS[$lock]:-}"
  if [[ -n "$fd" ]]; then
    ( eval "exec ${fd}>&-"; exec nohup "$@" >>"$logfile" 2>&1 ) &
  else
    ( exec nohup "$@" >>"$logfile" 2>&1 ) &
  fi
}

_executor_up() {
  init
  command -v executor >/dev/null 2>&1 || {
    [[ "${INSTALL_EXECUTOR:-0}" == 1 ]] && { echo "executor not installed" >&2; return 1; }
    echo "executor disabled"
    return 0
  }
  _acquire_daemon_lock "$EXECUTOR_LOCK" || { echo "could not acquire Executor lock" >&2; return 1; }
  if _port_open; then
    echo "executor daemon: running"
    _release_daemon_lock "$EXECUTOR_LOCK"
    return 0
  fi
  echo "starting executor daemon"
  rm -f "$AGENT_HOME/.executor"/daemon-active-* 2>/dev/null || true
  executor daemon run >>"$LOGS/executor.log" 2>&1 || true
  _wait_port open || { echo "executor failed to become ready; see: hb logs executor" >&2; _release_daemon_lock "$EXECUTOR_LOCK"; return 1; }
  echo "executor daemon: ready"
  _release_daemon_lock "$EXECUTOR_LOCK"
}

_gateway_running() {
  pgrep -u "$(id -u)" -f '[h]ermes( .*)? gateway run' >/dev/null 2>&1
}

# Returns 0 on success, 1 on a real failure, 2 if the lock couldn't be
# acquired (someone else is mid-operation — not necessarily broken). Callers
# must not react to 2 the same way as 1: stopping the gateway because *this*
# call lost a lock race would kill another process's legitimately-running
# gateway.
_start_gateway() {
  [[ "${INSTALL_HERMES:-0}" == 1 ]] || return 0
  [[ ! -e "$QUIESCE_FILE" && ! -e "$GATEWAY_DISABLED" ]] || return 0
  command -v hermes >/dev/null 2>&1 || { echo "hermes not installed" >&2; return 1; }
  _acquire_daemon_lock "$GATEWAY_LOCK" || { echo "could not acquire Hermes gateway lock" >&2; return 2; }
  if _gateway_running; then
    local count
    count="$(pgrep -u "$(id -u)" -f '[h]ermes( .*)? gateway run' | wc -l | tr -d ' ')"
    if [[ "$count" != 1 ]]; then
      echo "multiple Hermes gateway processes detected" >&2
      _release_daemon_lock "$GATEWAY_LOCK"
      return 1
    fi
    pgrep -u "$(id -u)" -f '[h]ermes( .*)? gateway run' | head -1 >"$GATEWAY_PID"
    _release_daemon_lock "$GATEWAY_LOCK"
    return 0
  fi
  rm -f "$GATEWAY_PID"
  _spawn_without_lock_fd "$GATEWAY_LOCK" "$LOGS/hermes-gateway.log" hermes gateway run --replace
  printf '%s\n' "$!" >"$GATEWAY_PID"
  _release_daemon_lock "$GATEWAY_LOCK"
}

up() {
  init
  rm -f "$QUIESCE_FILE"
  _executor_up || return 1
  _start_gateway
}

reconcile() {
  init
  [[ ! -e "$QUIESCE_FILE" ]] || return 0
  _executor_up || return 1
  _start_gateway
}

_stop_executor() {
  command -v executor >/dev/null 2>&1 && executor daemon stop >/dev/null 2>&1 || true
  pkill -f "executor daemon run" 2>/dev/null || true
  rm -f "$AGENT_HOME/.executor"/daemon-active-* 2>/dev/null || true
  _wait_port closed || { echo "executor failed to stop" >&2; return 1; }
}

_stop_gateway() {
  local attempt
  pkill -TERM -u "$(id -u)" -f '[h]ermes( .*)? gateway run' 2>/dev/null || true
  for ((attempt = 0; attempt < 30; attempt++)); do
    _gateway_running || break
    sleep 1
  done
  pkill -KILL -u "$(id -u)" -f '[h]ermes( .*)? gateway run' 2>/dev/null || true
  rm -f "$GATEWAY_PID"
  ! _gateway_running || { echo "Hermes gateway failed to stop" >&2; return 1; }
}

pause() {
  local failed=0
  init
  touch "$QUIESCE_FILE"
  _stop_gateway || failed=1
  _stop_executor || failed=1
  if command -v hermes-state >/dev/null 2>&1; then
    hermes-state verify --checkpoint >/dev/null || failed=1
  fi
  [[ "$failed" == 0 ]] || return 1
  echo "Hermes gateway and Executor: quiesced"
}

resume() {
  rm -f "$QUIESCE_FILE"
  up
}

down() { pause; }
is_paused() { [[ -e "$QUIESCE_FILE" ]]; }
gateway_is_disabled() { [[ -e "$GATEWAY_DISABLED" ]] && ! _gateway_running; }

gateway_enable() {
  local flag="${1:-}" phrase="${2:-}"
  init
  [[ "$flag" == --confirm-single-writer && "$phrase" == I_CONFIRM_NO_OTHER_GATEWAY_USES_THIS_IDENTITY ]] || {
    echo "refusing gateway start without: --confirm-single-writer I_CONFIRM_NO_OTHER_GATEWAY_USES_THIS_IDENTITY" >&2
    return 1
  }
  [[ ! -e "$QUIESCE_FILE" ]] || { echo "box is quiesced; resume it before requesting gateway startup" >&2; return 1; }
  # The cutover gates compare live state against the import baselines, so they
  # can only pass before the gateway's first run — after that, legitimate new
  # messages diverge the database from the manifest forever. Gate only the
  # FIRST enable after each import: a successful enable records
  # gateway_enabled=true in the manifest, and every new import resets it.
  if [[ -r "$STATE_DIR/import-manifest.json" ]] &&
    [[ "$(jq -r '.gateway_enabled // false' "$STATE_DIR/import-manifest.json" 2>/dev/null)" != true ]]; then
    cutover_ready || return 1
  fi
  rm -f "$GATEWAY_DISABLED"
  _start_gateway
  local start_status=$?
  if [[ "$start_status" == 2 ]]; then
    # Lost the lock race to a concurrent operation (e.g. hb-workload's
    # reconcile loop) — leave whatever it's doing alone. Stopping the
    # gateway here could kill a process that other call legitimately just
    # started.
    touch "$GATEWAY_DISABLED"
    echo "gateway is busy with a concurrent operation; re-run once it settles" >&2
    return 1
  elif [[ "$start_status" != 0 ]]; then
    _stop_gateway || true
    touch "$GATEWAY_DISABLED"
    return 1
  fi
  if [[ -r "$STATE_DIR/import-manifest.json" ]]; then
    local manifest_tmp
    if ! { manifest_tmp="$(mktemp "$STATE_DIR/import-manifest.json.tmp.XXXXXX")" &&
      jq '.gateway_enabled = true' "$STATE_DIR/import-manifest.json" >"$manifest_tmp" &&
      chmod 600 "$manifest_tmp" &&
      mv "$manifest_tmp" "$STATE_DIR/import-manifest.json"; }; then
      rm -f "$manifest_tmp"
      echo "warning: could not record gateway_enabled in the import manifest; the next gateway-enable will re-run cutover gates against stale baselines" >&2
    fi
  fi
  echo "Hermes gateway startup requested; run 'hb doctor' and require deep health before declaring cutover complete"
}

gateway_disable() {
  init
  # The marker may be root-owned from provisioning; touch then fails to update
  # its mtime, which is fine — but "disabled" must never be claimed unless the
  # durable marker actually exists.
  touch "$GATEWAY_DISABLED" 2>/dev/null || true
  [[ -e "$GATEWAY_DISABLED" ]] || { echo "could not persist gateway-disabled marker at $GATEWAY_DISABLED" >&2; return 1; }
  _stop_gateway || return 1
  echo "Hermes gateway: disabled"
}

verify_state() { hermes-state verify "$@"; }

acknowledge_active_paths() {
  hermes-state acknowledge-paths >/dev/null || return 1
  echo "active import paths acknowledged"
}

cutover_ready() {
  [[ -e "$GATEWAY_DISABLED" ]] || { echo "gateway must be disabled before cutover" >&2; return 1; }
  ! _gateway_running || { echo "gateway is still running" >&2; return 1; }
  hermes-state cutover-check
  echo "cutover-ready: import report, DB and inventory baselines, Discord config, active paths, disabled marker, and single-writer process gates passed"
}

web() {
  command -v executor >/dev/null 2>&1 || { echo "executor not installed" >&2; return 1; }
  executor web "$@"
}

executor_token() {
  [[ -r "$TOKEN_FILE" ]] || return 1
  sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$TOKEN_FILE" | head -1
}

_write_token_env() {
  local token="$1" tmp
  mkdir -p "$(dirname "$TOKEN_ENV")"
  tmp="${TOKEN_ENV}.tmp.$$"
  umask 077
  printf "export EXECUTOR_MCP_TOKEN='%s'\n" "$token" >"$tmp"
  mv "$tmp" "$TOKEN_ENV"
  chmod 0600 "$TOKEN_ENV"
}

_unwire_legacy() {
  if command -v claude >/dev/null 2>&1; then
    (cd "$AGENT_HOME/workspace" && claude mcp remove executor -s local >/dev/null 2>&1) || true
    claude mcp remove executor -s user >/dev/null 2>&1 || true
  fi
  command -v codex >/dev/null 2>&1 && codex mcp remove executor >/dev/null 2>&1 || true
}

wire_mcp() {
  [[ ! -e "$QUIESCE_FILE" ]] || {
    echo "box is quiesced; run 'hb resume' explicitly before changing MCP wiring" >&2
    return 1
  }
  if [[ "${WIRE_EXECUTOR_MCP:-0}" != 1 ]]; then
    echo "executor MCP wiring disabled"
    _unwire_legacy
    rm -f "$WIRED" "$TOKEN_ENV"
    return 0
  fi
  command -v executor >/dev/null 2>&1 || { echo "executor not installed" >&2; return 1; }
  up >/dev/null
  local token url="http://127.0.0.1:${EXECUTOR_PORT:-4788}/mcp" failed=0
  token="$(executor_token)"
  [[ -n "$token" ]] || { echo "executor token unavailable" >&2; return 1; }
  _write_token_env "$token"
  export EXECUTOR_MCP_TOKEN="$token"
  _unwire_legacy

  if command -v claude >/dev/null 2>&1; then
    claude mcp add executor "$url" -s user -t http -H "Authorization: Bearer $token" >/dev/null 2>&1 || {
      echo "claude: failed to register Executor HTTP MCP" >&2
      failed=1
    }
  fi
  if command -v codex >/dev/null 2>&1; then
    codex mcp add executor --url "$url" --bearer-token-env-var EXECUTOR_MCP_TOKEN >/dev/null 2>&1 || {
      echo "codex: failed to register Executor HTTP MCP" >&2
      failed=1
    }
  fi
  [[ "$failed" == 0 ]] || return 1
  printf '%s\n' "$WIRE_VERSION" >"$WIRED"
  echo "executor HTTP MCP registered for claude and codex"
}

wire_once() {
  local token
  if [[ "${WIRE_EXECUTOR_MCP:-0}" != 1 ]]; then wire_mcp; return; fi
  token="$(executor_token 2>/dev/null || true)"
  if [[ -f "$WIRED" && "$(cat "$WIRED")" == "$WIRE_VERSION" && -r "$TOKEN_ENV" && -n "$token" ]] &&
    grep -Fq "$token" "$TOKEN_ENV"; then return 0; fi
  wire_mcp
}

write_manifest() {
  local dir="$AGENT_HOME/.config/hermes-box" tmp manifest
  dir="$AGENT_HOME/.config/hermes-box"
  manifest="$dir/runtime-manifest"
  tmp="${manifest}.tmp.$$"
  mkdir -p "$dir"
  umask 077
  {
    printf 'created_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'base_image=%s\n' "${BASE_IMAGE:-unknown}"
    printf 'node=%s\n' "$(node --version 2>/dev/null || echo missing)"
    printf 'claude=%s\n' "$(claude --version 2>/dev/null || echo missing)"
    printf 'codex=%s\n' "$(codex --version 2>/dev/null || echo missing)"
    printf 'hermes=%s\n' "$(hermes --version 2>/dev/null | head -1 || echo missing)"
    printf 'executor=%s\n' "$(executor --version 2>/dev/null || echo missing)"
  } >"$tmp"
  mv "$tmp" "$manifest"
  chmod 0600 "$manifest"
}

status() {
  local gateway_status
  if [[ -e "$GATEWAY_DISABLED" ]]; then
    gateway_status=disabled
  elif _gateway_running; then
    gateway_status=running
  else
    gateway_status=stopped
  fi
  printf 'executor: %s\n' "$(_port_open && echo running || echo stopped)"
  printf 'quiesced: %s\n' "$([[ -e "$QUIESCE_FILE" ]] && echo yes || echo no)"
  printf 'hermes:   %s\n' "$(command -v hermes >/dev/null 2>&1 && echo installed || echo 'not installed')"
  printf 'gateway:  %s\n' "$gateway_status"
  if [[ -r "$HERMES_HOME/gateway_state.json" ]]; then
    printf 'platform: %s\n' "$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("gateway_state", "unknown"))' "$HERMES_HOME/gateway_state.json" 2>/dev/null || echo invalid)"
  else
    printf 'platform: no runtime state\n'
  fi
  printf 'mcp:      %s\n' "$([[ -f "$WIRED" ]] && cat "$WIRED" || echo unwired)"
  printf 'data:     %s\n' "$(du -sh "$DATA" 2>/dev/null | cut -f1)"
}

versions() {
  echo "node:     $(node --version 2>/dev/null || echo -)"
  echo "uv:       $(uv --version 2>/dev/null || echo -)"
  echo "nvim:     $(nvim --version 2>/dev/null | head -1 || echo -)"
  echo "claude:   $(claude --version 2>/dev/null || echo -)"
  echo "codex:    $(codex --version 2>/dev/null || echo -)"
  echo "hermes:   $(hermes --version 2>/dev/null | head -1 || { command -v hermes >/dev/null 2>&1 && echo installed || echo -; })"
  echo "executor: $(executor --version 2>/dev/null || { command -v executor >/dev/null 2>&1 && echo installed || echo -; })"
}

_check() {
  local label="$1"
  shift
  if "$@"; then printf 'ok   %s\n' "$label"; else printf 'FAIL %s\n' "$label" >&2; return 1; fi
}

_command_exists() { command -v "$1" >/dev/null 2>&1; }
_hermes_state_valid() { hermes-state verify >/dev/null; }

_claude_http_config() {
  (cd "$AGENT_HOME/workspace" && claude mcp get executor 2>/dev/null) | grep -q "http://127.0.0.1:${EXECUTOR_PORT:-4788}/mcp"
}

_mcp_auth_works() {
  local token
  token="$(executor_token)" || return 1
  _mcp_initialize "http://127.0.0.1:${EXECUTOR_PORT:-4788}/mcp" "$token"
}

doctor() {
  local failed=0 cmd
  for cmd in node uv nvim claude codex; do
    _check "$cmd installed" _command_exists "$cmd" || failed=1
  done
  if [[ "${INSTALL_HERMES:-0}" == 1 ]]; then _check "hermes installed" _command_exists hermes || failed=1; fi
  if [[ "${INSTALL_HERMES:-0}" == 1 && ! -e "$GATEWAY_DISABLED" && ! -e "$QUIESCE_FILE" ]]; then
    _check "Hermes gateway process" _gateway_running || failed=1
    _check "Hermes gateway deep status" hermes gateway status --deep || failed=1
  else
    printf 'ok   Hermes gateway intentionally disabled or quiesced\n'
  fi
  if [[ "${INSTALL_EXECUTOR:-0}" == 1 ]]; then
    _check "executor installed" _command_exists executor || failed=1
    if [[ -e "$QUIESCE_FILE" ]]; then
      _check "Executor target port closed while quiesced" _port_closed || failed=1
    else
      _check "executor listening" _port_open || failed=1
      _check "executor MCP bearer accepted" _mcp_auth_works || failed=1
    fi
  fi
  _check "durable home writable" test -w "$AGENT_HOME" || failed=1
  _check "managed profile present" test -r /etc/profile.d/hermes-box.sh || failed=1
  if [[ "${INSTALL_HERMES:-0}" == 1 ]]; then
    _check "Hermes state integrity" _hermes_state_valid || failed=1
  else
    printf 'ok   Hermes state check skipped (INSTALL_HERMES != 1)\n'
  fi
  if [[ "${WIRE_EXECUTOR_MCP:-0}" == 1 ]]; then
    _check "MCP wiring version" test "$(cat "$WIRED" 2>/dev/null)" = "$WIRE_VERSION" || failed=1
    _check "MCP token environment" test -r "$TOKEN_ENV" || failed=1
    _check "Claude HTTP MCP config" _claude_http_config || failed=1
    _check "Codex HTTP MCP config" grep -q "url = \"http://127.0.0.1:${EXECUTOR_PORT:-4788}/mcp\"" "$CODEX_HOME/config.toml" || failed=1
  fi
  [[ "$failed" == 0 ]]
}

logs() {
  local name="${1:-executor}"
  [[ "$name" == hermes || "$name" == gateway ]] && name=hermes-gateway
  tail -n 200 -F "$LOGS/${name}.log"
}

main() {
  case "${1:-status}" in
    init) init ;;
    up) up ;;
    reconcile) reconcile ;;
    down | pause) pause ;;
    resume) resume ;;
    is-paused) is_paused ;;
    gateway-is-disabled) gateway_is_disabled ;;
    gateway-enable) shift; gateway_enable "$@" ;;
    gateway-disable) gateway_disable ;;
    verify-state) shift; verify_state "$@" ;;
    acknowledge-active-paths) acknowledge_active_paths ;;
    cutover-ready) cutover_ready ;;
    web) shift; web "$@" ;;
    executor-token) executor_token ;;
    wire-mcp) wire_mcp ;;
    wire-once) wire_once ;;
    write-manifest) write_manifest ;;
    doctor) doctor ;;
    status) status ;;
    versions) versions ;;
    logs) shift; logs "${1:-executor}" ;;
    *) echo "usage: hb {init|up|reconcile|down|pause|resume|gateway-enable|gateway-disable|verify-state|acknowledge-active-paths|cutover-ready|web|wire-mcp|doctor|status|versions|logs}"; return 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
