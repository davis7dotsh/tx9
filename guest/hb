#!/usr/bin/env bash
# hb — in-box control for durable layout, Hermes, Executor, and diagnostics.
set -uo pipefail
# shellcheck disable=SC1091
[ -f /etc/profile.d/hermes-box.sh ] && . /etc/profile.d/hermes-box.sh
export TX9_LOG_MAX_BYTES TX9_LOG_MAX_FILES
HB_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=guest/lib-mcp.sh
. "$HB_BIN_DIR/lib-mcp.sh"

DATA="${HB_DATA:-/data}"
AGENT_HOME="$DATA/home/agent"
LOGS="$DATA/logs"
STATE_DIR="$AGENT_HOME/.config/hermes-box"
QUIESCE_FILE="$STATE_DIR/quiesced"
LEGACY_QUIESCE_FILE="${HB_LEGACY_QUIESCE_FILE:-/tmp/hermes-box-executor-paused}"
GATEWAY_DISABLED="$STATE_DIR/gateway-disabled"
GATEWAY_POLICY="$STATE_DIR/gateway-policy-initialized"
GATEWAY_PID="$STATE_DIR/gateway.pid"
GATEWAY_LOCK="$STATE_DIR/gateway.lock"
GATEWAY_RELOAD_REQUESTS="$STATE_DIR/gateway-reload-requests"
GATEWAY_RELOAD_LOCK="$STATE_DIR/gateway-reload.lock"
EXECUTOR_LOCK="$STATE_DIR/executor.lock"
SERVICES_DIR="$STATE_DIR/services.d"
WIRE_VERSION=http-v3
WIRED="$AGENT_HOME/.hermes-box-wired"
TOKEN_FILE="$AGENT_HOME/.executor/server-control/auth.json"
TOKEN_ENV="$AGENT_HOME/.config/hermes-box/executor-mcp.env"
# The initiating start holds GATEWAY_LOCK while polling for the real child.
# Its lock wait must be comfortably longer than that polling window so a
# concurrent explicit enable observes the pending wrapper instead of timing
# out and recreating the disabled marker underneath it.
GATEWAY_LOCK_WAIT_SECONDS=10
GATEWAY_START_WAIT_ATTEMPTS=50
GATEWAY_START_WAIT_INTERVAL=0.1
GATEWAY_RESTART_DELAY="${HB_GATEWAY_RESTART_DELAY:-2}"

# Remote-executor mode (Docker compose split): when EXECUTOR_HOST points away
# from loopback, Executor runs in its own container. hb then only checks
# reachability and wires MCP against it — it never spawns, stops, or reads
# token files locally; the runtime supplies EXECUTOR_MCP_TOKEN via the
# environment instead.
EXECUTOR_HOST="${EXECUTOR_HOST:-127.0.0.1}"
_exec_remote() { [[ "$EXECUTOR_HOST" != 127.0.0.1 ]]; }
_executor_url() { printf 'http://%s:%s/mcp' "$EXECUTOR_HOST" "${EXECUTOR_PORT:-4788}"; }

# Steady-state reporting: the reconcile loop re-checks Executor every cycle,
# so unchanged results must not re-log — they flooded the durable agent
# stream with one identical line per cycle. Non-durable state under /tmp
# resets with the container, so the first check after a restart always logs.
HB_RUNTIME_STATE_DIR="${HB_RUNTIME_STATE_DIR:-/tmp/hermes-box-runtime}"
HB_STEADY_QUIET="${HB_STEADY_QUIET:-0}"
_steady_report() {  # <key> <state> <message> [stderr]
  local key="$1" state="$2" message="$3" fd="${4:-stdout}" state_file
  if [[ "$HB_STEADY_QUIET" != 1 ]]; then
    if [[ "$fd" == stderr ]]; then echo "$message" >&2; else echo "$message"; fi
    return 0
  fi
  state_file="$HB_RUNTIME_STATE_DIR/$key.state"
  [[ "$(cat "$state_file" 2>/dev/null)" != "$state" ]] || return 0
  mkdir -p "$HB_RUNTIME_STATE_DIR" 2>/dev/null || true
  printf '%s' "$state" >"$state_file" 2>/dev/null || true
  if [[ "$fd" == stderr ]]; then echo "$message" >&2; else echo "$message"; fi
}

init() {
  local managed=(
    "$AGENT_HOME" "$AGENT_HOME/.claude" "$AGENT_HOME/.codex" "$AGENT_HOME/.hermes"
    "$AGENT_HOME/workspace" "$AGENT_HOME/.config" "$AGENT_HOME/.config/hermes-box"
    "$SERVICES_DIR" "$AGENT_HOME/.local" "$AGENT_HOME/.local/share"
    "$AGENT_HOME/.local/state" "$LOGS"
  )
  mkdir -p "${managed[@]}"
  chmod 0700 "$SERVICES_DIR" 2>/dev/null || true
  id agent >/dev/null 2>&1 && chown agent:agent "${managed[@]}" 2>/dev/null || true
  if [[ -e "$LEGACY_QUIESCE_FILE" ]]; then
    touch "$QUIESCE_FILE" || return 1
    rm -f "$LEGACY_QUIESCE_FILE" || return 1
  fi
  if [[ ! -e "$GATEWAY_POLICY" ]]; then
    touch "$GATEWAY_DISABLED" "$GATEWAY_POLICY"
  fi
  # Provisioning runs init as root, which would leave the policy markers
  # root-owned; later agent-run gateway_disable/gateway_enable must be able
  # to recreate and remove them.
  id agent >/dev/null 2>&1 && chown agent:agent "$GATEWAY_DISABLED" "$GATEWAY_POLICY" 2>/dev/null || true
}

_services_helper() {
  local helper
  helper="$(command -v tx9-services 2>/dev/null || true)"
  [[ -n "$helper" ]] || helper="$HB_BIN_DIR/tx9-services"
  [[ -x "$helper" ]] || {
    echo "tx9-services is unavailable" >&2
    return 1
  }
  TX9_SERVICES_CONFIG_ROOT="$STATE_DIR" TX9_SERVICES_LOG_DIR="$LOGS" "$helper" "$@"
}

_services_reconcile() { _services_helper reconcile; }
_services_stop() { _services_helper stop-all; }

_port_open() {
  (exec 3<>"/dev/tcp/$EXECUTOR_HOST/${EXECUTOR_PORT:-4788}") 2>/dev/null && { exec 3>&-; return 0; }
  return 1
}

_port_closed() { ! _port_open; }

_wait_port() {
  local expected="$1" attempt
  for ((attempt = 0; attempt < 30; attempt++)); do
    if [[ "$expected" == open ]] && _port_open; then return 0; fi
    if [[ "$expected" == closed ]] && ! _port_open; then return 0; fi
    sleep 1
  done
  return 1
}

# flock-based lock generalized for any check-then-spawn daemon start (gateway,
# executor, and future daemons share this rather than each hand-rolling its
# own copy). Without it, hb-workload's 20s reconcile loop and a host-initiated
# `hb up` can both observe "not running" and both spawn the same daemon.
#
# flock over a hand-rolled mkdir+pid-file lock specifically because stale-lock
# recovery is the hard part to get right with plain filesystem primitives: an
# earlier mkdir/rm-rf-based version of this (and an mv-based "fix" to it) both
# had a confirmed TOCTOU window where two contenders racing to reclaim the
# same dead-owner lock could end up both "holding" it. flock is kernel-
# enforced and auto-releases the instant every fd referencing it closes, with
# no manual dead-owner detection needed — verified directly: 8 trials of 10
# processes racing a pre-seeded "stale" lock all converged on exactly one
# winner, and killing -9 a holder mid-section let the next contender acquire
# in ~0.2s instead of the 5s timeout.
declare -A _DAEMON_LOCK_FDS

_acquire_daemon_lock() {
  local lock="$1"
  local wait_seconds="${2:-5}"
  local fd
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  exec {fd}>"$lock"
  if ! flock -w "$wait_seconds" "$fd"; then
    eval "exec ${fd}>&-"
    return 1
  fi
  _DAEMON_LOCK_FDS["$lock"]="$fd"
}

_release_daemon_lock() {
  local lock="$1"
  local fd="${_DAEMON_LOCK_FDS[$lock]:-}"
  [[ -n "$fd" ]] || return 0
  flock -u "$fd" 2>/dev/null || true
  eval "exec ${fd}>&-" 2>/dev/null || true
  unset "_DAEMON_LOCK_FDS[$lock]"
}

_valid_open_fd() {
  local candidate="$1"
  [[ "$candidate" =~ ^[0-9]+$ && -e "/proc/self/fd/$candidate" ]]
}

# Inherited mirror-FD numbers are an atomic pair. Presence of the strings is
# not proof the descriptors are still open here: hb-workload keeps the outer
# capture's environment, then later hb subprocesses can retain the names after
# those descriptors were closed or reused for a lock.
_sanitize_log_mirror_fds() {
  if ! _valid_open_fd "${TX9_LOG_MIRROR_STDOUT_FD:-}" ||
     ! _valid_open_fd "${TX9_LOG_MIRROR_STDERR_FD:-}"; then
    unset TX9_LOG_MIRROR_STDOUT_FD TX9_LOG_MIRROR_STDERR_FD
  fi
}

_clear_gateway_start_failure() {
  rm -f "$HB_RUNTIME_STATE_DIR/gateway-start.state" 2>/dev/null || true
}

_report_gateway_start_failure() {
  _steady_report gateway-start failed "$1" stderr
}

# A long-lived daemon spawned with a lock fd still open would inherit it and
# hold the underlying flock open for its entire lifetime (file description
# locks survive fork; the kernel only auto-releases once every fd referring
# to it, across every process, is closed) — wedging every future acquire
# attempt until that daemon exits. Verified: without this, a spawned `sleep`
# standing in for a daemon kept the lock held after the spawning shell
# explicitly released it; with it, a fresh acquire attempt succeeded in
# milliseconds right after spawning.
_spawn_without_lock_fd() {
  shift
  local logfile="$1" fd source log_dir launcher_log
  local -a capture_cmd child_cmd
  shift
  child_cmd=("$@")
  # A daemon start can occur while a higher-level coordination lock is also
  # held (for example, the MCP reload lock around a gateway restart). Close
  # every tracked lock fd in the child so no long-lived daemon inherits and
  # pins any of them after the spawning shell releases its copies. Validate
  # inherited mirror FDs after that cleanup: a lock fd can reuse a stale
  # mirror number, and closing it must not leave TX9_LOG_MIRROR_*_FD pointing
  # at a now-closed descriptor.
  (
    for fd in "${_DAEMON_LOCK_FDS[@]}"; do
      eval "exec ${fd}>&-"
    done
    _sanitize_log_mirror_fds
    if command -v tx9-logs >/dev/null 2>&1; then
      source="$(basename "$logfile" .log)"
      [[ "$source" != hermes-gateway ]] || source=hermes
      log_dir="$(dirname "$logfile")"
      launcher_log="${logfile%.log}.launcher.log"
      capture_cmd=(tx9-logs capture --source "$source" --log-dir "$log_dir")
      if [[ "$source" == hermes ]]; then
        # The wrapper is Hermes' process manager. Restart unexpected child
        # exits; --external-supervisor makes in-chat restart/update return
        # here instead of daemonizing a replacement.
        capture_cmd+=(--restart-delay "$GATEWAY_RESTART_DELAY")
        child_cmd+=(--external-supervisor)
      fi
      exec nohup "${capture_cmd[@]}" -- "${child_cmd[@]}" \
        </dev/null >/dev/null 2>>"$launcher_log"
    fi
    exec nohup "${child_cmd[@]}" >>"$logfile" 2>&1
  ) &
}

_executor_up() {
  init
  if _exec_remote; then
    _wait_port open || { _steady_report executor unreachable "remote executor unreachable at $EXECUTOR_HOST:${EXECUTOR_PORT:-4788}" stderr; return 1; }
    _steady_report executor reachable "executor daemon: reachable (remote)"
    return 0
  fi
  command -v executor >/dev/null 2>&1 || {
    [[ "${INSTALL_EXECUTOR:-0}" == 1 ]] && { echo "executor not installed" >&2; return 1; }
    echo "executor disabled"
    return 0
  }
  _acquire_daemon_lock "$EXECUTOR_LOCK" || { echo "could not acquire Executor lock" >&2; return 1; }
  if _port_open; then
    _steady_report executor running "executor daemon: running"
    _release_daemon_lock "$EXECUTOR_LOCK"
    return 0
  fi
  echo "starting executor daemon"
  rm -f "$AGENT_HOME/.executor"/daemon-active-* 2>/dev/null || true
  if command -v tx9-logs >/dev/null 2>&1; then
    tx9-logs capture --source executor --log-dir "$LOGS" -- executor daemon run || true
  else
    executor daemon run >>"$LOGS/executor.log" 2>&1 || true
  fi
  _wait_port open || { echo "executor failed to become ready; see: hb logs executor" >&2; _release_daemon_lock "$EXECUTOR_LOCK"; return 1; }
  echo "executor daemon: ready"
  _release_daemon_lock "$EXECUTOR_LOCK"
}

_gateway_pids() {
  local pid command_line
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    command_line="$(ps -o args= -p "$pid" 2>/dev/null)" || continue
    [[ "$command_line" != *"tx9-logs capture"* ]] || continue
    printf '%s\n' "$pid"
  done < <(pgrep -u "$(id -u)" -f '[h]ermes( .*)? gateway run' 2>/dev/null || true)
}

_gateway_capture_pids() {
  local pid command_line
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    command_line="$(ps -o args= -p "$pid" 2>/dev/null)" || continue
    [[ "$command_line" == *"tx9-logs capture"* && "$command_line" == *"--source hermes"* ]] || continue
    printf '%s\n' "$pid"
  done < <(pgrep -u "$(id -u)" -f '[h]ermes( .*)? gateway run' 2>/dev/null || true)
}

_gateway_running() {
  [[ -n "$(_gateway_pids)" ]]
}

_gateway_or_capture_running() {
  _gateway_running || [[ -n "$(_gateway_capture_pids)" ]]
}

# Print the real gateway PID and return 0 once it appears. Return 2 when the
# capture wrapper is still healthy after the short synchronous wait: it may be
# migrating a large legacy log before starting Hermes, so callers must leave it
# running and let a later reconciliation observe the child. Return 1 only for
# a dead wrapper or an invalid process count.
_wait_gateway_pid() {
  local wrapper_pid="$1" attempts="${2:-$GATEWAY_START_WAIT_ATTEMPTS}" attempt state
  local -a gateway_pids
  for ((attempt = 0; attempt < attempts; attempt++)); do
    mapfile -t gateway_pids < <(_gateway_pids)
    if ((${#gateway_pids[@]} == 1)); then
      printf '%s\n' "${gateway_pids[0]}"
      return 0
    fi
    ((${#gateway_pids[@]} == 0)) || return 1
    kill -0 "$wrapper_pid" 2>/dev/null || return 1
    state="$(ps -o stat= -p "$wrapper_pid" 2>/dev/null)" || return 1
    [[ "$state" != Z* ]] || return 1
    sleep "$GATEWAY_START_WAIT_INTERVAL"
  done
  return 2
}

_load_executor_mcp_env() {
  if [[ "${WIRE_EXECUTOR_MCP:-0}" != 1 ]]; then
    unset EXECUTOR_MCP_TOKEN
  elif [[ -n "${BOXD_EXECUTOR_TOKEN:-}" ]]; then
    export EXECUTOR_MCP_TOKEN="$BOXD_EXECUTOR_TOKEN"
  elif [[ -n "${EXECUTOR_MCP_TOKEN:-}" ]]; then
    export EXECUTOR_MCP_TOKEN
  elif [[ -r "$TOKEN_ENV" ]]; then
    # shellcheck disable=SC1090
    . "$TOKEN_ENV"
  else
    unset EXECUTOR_MCP_TOKEN
  fi
}

# Returns 0 on success, 1 on a real failure, 2 if the lock couldn't be
# acquired (someone else is mid-operation — not necessarily broken). Callers
# must not react to 2 the same way as 1: stopping the gateway because *this*
# call lost a lock race would kill another process's legitimately-running
# gateway.
_start_gateway() {
  local wrapper_pid gateway_pid wait_status
  local -a gateway_pids capture_pids
  [[ "${INSTALL_HERMES:-0}" == 1 ]] || return 0
  [[ ! -e "$QUIESCE_FILE" && ! -e "$GATEWAY_DISABLED" ]] || return 0
  command -v hermes >/dev/null 2>&1 || { echo "hermes not installed" >&2; return 1; }
  _acquire_daemon_lock "$GATEWAY_LOCK" "$GATEWAY_LOCK_WAIT_SECONDS" || { echo "could not acquire Hermes gateway lock" >&2; return 2; }
  mapfile -t gateway_pids < <(_gateway_pids)
  if ((${#gateway_pids[@]} > 0)); then
    if ((${#gateway_pids[@]} != 1)); then
      echo "multiple Hermes gateway processes detected" >&2
      _release_daemon_lock "$GATEWAY_LOCK"
      return 1
    fi
    printf '%s\n' "${gateway_pids[0]}" >"$GATEWAY_PID"
    _clear_gateway_start_failure
    _release_daemon_lock "$GATEWAY_LOCK"
    return 0
  fi
  mapfile -t capture_pids < <(_gateway_capture_pids)
  if ((${#capture_pids[@]} > 0)); then
    if ((${#capture_pids[@]} != 1)); then
      _report_gateway_start_failure "Hermes gateway capture is pending but did not start cleanly"
      _release_daemon_lock "$GATEWAY_LOCK"
      return 1
    fi
    if gateway_pid="$(_wait_gateway_pid "${capture_pids[0]}" 1)"; then
      wait_status=0
    else
      wait_status=$?
    fi
    if [[ "$wait_status" == 0 ]]; then
      printf '%s\n' "$gateway_pid" >"$GATEWAY_PID"
      _clear_gateway_start_failure
    elif [[ "$wait_status" != 2 ]]; then
      _report_gateway_start_failure "Hermes gateway capture is pending but did not start cleanly"
      _release_daemon_lock "$GATEWAY_LOCK"
      return 1
    else
      rm -f "$GATEWAY_PID"
    fi
    _release_daemon_lock "$GATEWAY_LOCK"
    return 0
  fi
  rm -f "$GATEWAY_PID"
  _load_executor_mcp_env
  _spawn_without_lock_fd "$GATEWAY_LOCK" "$LOGS/hermes-gateway.log" hermes gateway run --replace
  wrapper_pid="$!"
  if gateway_pid="$(_wait_gateway_pid "$wrapper_pid")"; then
    wait_status=0
  else
    wait_status=$?
  fi
  if [[ "$wait_status" == 2 ]]; then
    # A live wrapper owns this launch. Releasing the flock is safe because
    # later callers detect that wrapper and will not start a duplicate.
    _release_daemon_lock "$GATEWAY_LOCK"
    return 0
  elif [[ "$wait_status" != 0 ]]; then
    local wrapper_status=1
    kill -TERM "$wrapper_pid" 2>/dev/null || true
    wait "$wrapper_pid" 2>/dev/null && wrapper_status=0 || wrapper_status=$?
    _report_gateway_start_failure \
      "Hermes gateway failed to start; nested tx9-logs exited ${wrapper_status} before Hermes exec; see: $LOGS/hermes-gateway.launcher.log"
    _release_daemon_lock "$GATEWAY_LOCK"
    return 1
  fi
  printf '%s\n' "$gateway_pid" >"$GATEWAY_PID"
  _clear_gateway_start_failure
  _release_daemon_lock "$GATEWAY_LOCK"
}

up() {
  local services_failed=0
  local gateway_status

  init
  rm -f "$QUIESCE_FILE"
  _services_reconcile || {
    services_failed=1
    echo "warning: custom service reconciliation failed; run 'hb services-reload' for details" >&2
  }
  _executor_up || return 1
  _start_gateway
  gateway_status=$?
  [[ "$gateway_status" == 0 ]] || return "$gateway_status"
  [[ "$services_failed" == 0 ]]
}

reconcile() {
  init
  if [[ -e "$QUIESCE_FILE" ]]; then
    _services_stop
    return
  fi
  _services_reconcile || echo "warning: custom service reconciliation failed; continuing core reconciliation" >&2
  HB_STEADY_QUIET=1 _executor_up || return 1
  _start_gateway
}

_stop_executor() {
  # Remote executor has its own container lifecycle; quiescing this box must
  # not (and cannot) stop it. boxd stops the executor service around saves.
  _exec_remote && return 0
  command -v executor >/dev/null 2>&1 && executor daemon stop >/dev/null 2>&1 || true
  pkill -f "executor daemon run" 2>/dev/null || true
  rm -f "$AGENT_HOME/.executor"/daemon-active-* 2>/dev/null || true
  _wait_port closed || { echo "executor failed to stop" >&2; return 1; }
}

_stop_gateway() {
  local attempt
  # The capture argv includes `hermes gateway run`, so this TERM reaches the
  # wrapper as well as the child. The wrapper must see the signal: otherwise
  # --restart-delay would bring the gateway back after an intentional stop.
  pkill -TERM -u "$(id -u)" -f '[h]ermes( .*)? gateway run' 2>/dev/null || true
  for ((attempt = 0; attempt < 30; attempt++)); do
    _gateway_or_capture_running || break
    sleep 1
  done
  pkill -KILL -u "$(id -u)" -f '[h]ermes( .*)? gateway run' 2>/dev/null || true
  rm -f "$GATEWAY_PID"
  ! _gateway_or_capture_running || { echo "Hermes gateway failed to stop" >&2; return 1; }
}

pause() {
  local failed=0
  init
  touch "$QUIESCE_FILE"
  _services_stop || failed=1
  _stop_gateway || failed=1
  _stop_executor || failed=1
  if command -v hermes-state >/dev/null 2>&1; then
    hermes-state verify --checkpoint >/dev/null || failed=1
  fi
  [[ "$failed" == 0 ]] || return 1
  echo "Custom services, Hermes gateway, and Executor: quiesced"
}

resume() {
  rm -f "$QUIESCE_FILE"
  up
}

down() { pause; }
is_paused() { [[ -e "$QUIESCE_FILE" ]]; }
gateway_is_disabled() { [[ -e "$GATEWAY_DISABLED" ]] && ! _gateway_running; }

gateway_enable() {
  local flag="${1:-}" phrase="${2:-}"
  init
  [[ "$flag" == --confirm-single-writer && "$phrase" == I_CONFIRM_NO_OTHER_GATEWAY_USES_THIS_IDENTITY ]] || {
    echo "refusing gateway start without: --confirm-single-writer I_CONFIRM_NO_OTHER_GATEWAY_USES_THIS_IDENTITY" >&2
    return 1
  }
  [[ ! -e "$QUIESCE_FILE" ]] || { echo "box is quiesced; resume it before requesting gateway startup" >&2; return 1; }
  # The cutover gates compare live state against the import baselines, so they
  # can only pass before the gateway's first run — after that, legitimate new
  # messages diverge the database from the manifest forever. Gate only the
  # FIRST enable after each import: a successful enable records
  # gateway_enabled=true in the manifest, and every new import resets it.
  if [[ -r "$STATE_DIR/import-manifest.json" ]] &&
    [[ "$(jq -r '.gateway_enabled // false' "$STATE_DIR/import-manifest.json" 2>/dev/null)" != true ]]; then
    cutover_ready || return 1
  fi
  rm -f "$GATEWAY_DISABLED"
  _start_gateway
  local start_status=$?
  if [[ "$start_status" == 2 ]]; then
    # Lost the lock race to a concurrent operation (e.g. hb-workload's
    # reconcile loop) — leave whatever it's doing alone. Stopping the
    # gateway here could kill a process that other call legitimately just
    # started.
    touch "$GATEWAY_DISABLED"
    echo "gateway is busy with a concurrent operation; re-run once it settles" >&2
    return 1
  elif [[ "$start_status" != 0 ]]; then
    _stop_gateway || true
    touch "$GATEWAY_DISABLED"
    return 1
  fi
  if [[ -r "$STATE_DIR/import-manifest.json" ]]; then
    local manifest_tmp
    if ! { manifest_tmp="$(mktemp "$STATE_DIR/import-manifest.json.tmp.XXXXXX")" &&
      jq '.gateway_enabled = true' "$STATE_DIR/import-manifest.json" >"$manifest_tmp" &&
      chmod 600 "$manifest_tmp" &&
      mv "$manifest_tmp" "$STATE_DIR/import-manifest.json"; }; then
      rm -f "$manifest_tmp"
      echo "warning: could not record gateway_enabled in the import manifest; the next gateway-enable will re-run cutover gates against stale baselines" >&2
    fi
  fi
  echo "Hermes gateway startup requested; run 'hb doctor' and require deep health before declaring cutover complete"
}

gateway_disable() {
  init
  # The marker may be root-owned from provisioning; touch then fails to update
  # its mtime, which is fine — but "disabled" must never be claimed unless the
  # durable marker actually exists.
  touch "$GATEWAY_DISABLED" 2>/dev/null || true
  [[ -e "$GATEWAY_DISABLED" ]] || { echo "could not persist gateway-disabled marker at $GATEWAY_DISABLED" >&2; return 1; }
  _stop_gateway || return 1
  echo "Hermes gateway: disabled"
}

verify_state() { hermes-state verify "$@"; }

acknowledge_active_paths() {
  hermes-state acknowledge-paths >/dev/null || return 1
  echo "active import paths acknowledged"
}

cutover_ready() {
  [[ -e "$GATEWAY_DISABLED" ]] || { echo "gateway must be disabled before cutover" >&2; return 1; }
  ! _gateway_running || { echo "gateway is still running" >&2; return 1; }
  hermes-state cutover-check || return 1
  echo "cutover-ready: import report, DB and inventory baselines, Discord config, active paths, disabled marker, and single-writer process gates passed"
}

web() {
  command -v executor >/dev/null 2>&1 || { echo "executor not installed" >&2; return 1; }
  executor web "$@"
}

executor_token() {
  # BOXD_EXECUTOR_TOKEN is the runtime-injected token in the compose split.
  # It must win over EXECUTOR_MCP_TOKEN because /etc/profile.d sources the
  # on-disk executor-mcp.env, and after a restore that file carries the
  # SOURCE box's stale token — clobbering EXECUTOR_MCP_TOKEN and quietly
  # wiring MCP against a dead credential.
  if [[ -n "${BOXD_EXECUTOR_TOKEN:-}" ]]; then printf '%s\n' "$BOXD_EXECUTOR_TOKEN"; return 0; fi
  if [[ -r "$TOKEN_FILE" ]]; then
    sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$TOKEN_FILE" | head -1
    return 0
  fi
  [[ -n "${EXECUTOR_MCP_TOKEN:-}" ]] && { printf '%s\n' "$EXECUTOR_MCP_TOKEN"; return 0; }
  return 1
}

_write_token_env() {
  local token="$1" tmp
  mkdir -p "$(dirname "$TOKEN_ENV")"
  tmp="${TOKEN_ENV}.tmp.$$"
  umask 077
  printf "export EXECUTOR_MCP_TOKEN='%s'\n" "$token" >"$tmp"
  mv "$tmp" "$TOKEN_ENV"
  chmod 0600 "$TOKEN_ENV"
}

_unwire_legacy() {
  if command -v claude >/dev/null 2>&1; then
    (cd "$AGENT_HOME/workspace" && claude mcp remove executor -s local >/dev/null 2>&1) || true
    claude mcp remove executor -s user >/dev/null 2>&1 || true
  fi
  command -v codex >/dev/null 2>&1 && codex mcp remove executor >/dev/null 2>&1 || true
  if command -v hermes >/dev/null 2>&1; then
    # Hermes confirms removals interactively. Rewiring runs from the login
    # profile with output hidden, so answer explicitly instead of leaving an
    # invisible prompt attached to the user's terminal.
    printf 'y\n' | hermes mcp remove executor >/dev/null 2>&1 || return 1
  fi
}

_request_gateway_reload() {
  mkdir -p "$GATEWAY_RELOAD_REQUESTS"
  mktemp "$GATEWAY_RELOAD_REQUESTS/request.XXXXXX"
}

_hermes_config_fingerprint() {
  local config="${HERMES_HOME:-$AGENT_HOME/.hermes}/config.yaml"
  if [[ ! -e "$config" ]]; then
    printf 'missing\n'
  elif [[ -r "$config" ]]; then
    cksum <"$config"
  else
    return 1
  fi
}

_start_gateway_after_reload() {
  local status attempt
  _start_gateway
  status=$?
  [[ "$status" == 2 ]] || return "$status"
  # Another starter can briefly own GATEWAY_LOCK after the old process stops.
  # Accept the race only once that contender actually starts the gateway;
  # otherwise retry and preserve the reload request on a real failure.
  for attempt in 1 2 3 4 5; do
    _gateway_running && return 0
    sleep 1
    _start_gateway
    status=$?
    [[ "$status" == 0 ]] && return 0
    [[ "$status" == 2 ]] || return "$status"
  done
  return 2
}

gateway_reload_if_requested() {
  local requests=()
  _acquire_daemon_lock "$GATEWAY_RELOAD_LOCK" || return 1
  if [[ ! -d "$GATEWAY_RELOAD_REQUESTS" ]]; then
    _release_daemon_lock "$GATEWAY_RELOAD_LOCK"
    return 0
  fi
  mapfile -t requests < <(find "$GATEWAY_RELOAD_REQUESTS" -maxdepth 1 -type f -name 'request.*' -print)
  if ((${#requests[@]} == 0)); then
    _release_daemon_lock "$GATEWAY_RELOAD_LOCK"
    return 0
  fi
  if ! _gateway_running; then
    # A supervised gateway can be between child processes during its restart
    # delay. Keep the request until a child is observable: deleting it here
    # would race the wrapper's automatic restart and could skip the explicit
    # reload required for a concurrent config change.
    if [[ -n "$(_gateway_capture_pids)" ]]; then
      _release_daemon_lock "$GATEWAY_RELOAD_LOCK"
      return 0
    fi
    rm -f "${requests[@]}"
    _release_daemon_lock "$GATEWAY_RELOAD_LOCK"
    return 0
  fi
  if ! _stop_gateway || ! _start_gateway_after_reload; then
    _release_daemon_lock "$GATEWAY_RELOAD_LOCK"
    return 1
  fi
  # Remove only the generation just processed. Requests created while the
  # restart was in flight remain queued for the next reconciliation.
  rm -f "${requests[@]}"
  _release_daemon_lock "$GATEWAY_RELOAD_LOCK"
}

wire_mcp() {
  [[ ! -e "$QUIESCE_FILE" ]] || {
    echo "box is quiesced; run 'hb resume' explicitly before changing MCP wiring" >&2
    return 1
  }
  if [[ "${WIRE_EXECUTOR_MCP:-0}" != 1 ]]; then
    local config_before='' config_after='' reload_request='' reload_lock_held=0 fingerprint_before_valid=0
    echo "executor MCP wiring disabled"
    if command -v hermes >/dev/null 2>&1 && _gateway_running; then
      _acquire_daemon_lock "$GATEWAY_RELOAD_LOCK" || {
        echo "hermes: could not acquire gateway reload lock before MCP removal" >&2
        return 1
      }
      reload_lock_held=1
      if config_before="$(_hermes_config_fingerprint)"; then fingerprint_before_valid=1; fi
      if ! reload_request="$(_request_gateway_reload)"; then
        _release_daemon_lock "$GATEWAY_RELOAD_LOCK"
        echo "hermes: failed to request gateway reload before MCP removal" >&2
        return 1
      fi
    fi
    if ! _unwire_legacy; then
      if [[ "$reload_lock_held" == 1 ]]; then
        if [[ "$fingerprint_before_valid" == 1 ]] && config_after="$(_hermes_config_fingerprint)" &&
          [[ "$config_before" == "$config_after" ]]; then
          rm -f "$reload_request"
        fi
        _release_daemon_lock "$GATEWAY_RELOAD_LOCK"
      fi
      echo "hermes: failed to remove Executor MCP configuration" >&2
      return 1
    fi
    rm -f "$WIRED" "$TOKEN_ENV"
    if [[ "$reload_lock_held" == 1 ]]; then
      if [[ "$fingerprint_before_valid" == 1 ]] && config_after="$(_hermes_config_fingerprint)" &&
        [[ "$config_before" == "$config_after" ]]; then
        rm -f "$reload_request"
      fi
      _release_daemon_lock "$GATEWAY_RELOAD_LOCK"
    fi
    return 0
  fi
  _exec_remote || command -v executor >/dev/null 2>&1 || { echo "executor not installed" >&2; return 1; }
  up >/dev/null
  local token url failed=0 hermes_installed=0 hermes_reload_lock_held=0
  url="$(_executor_url)"
  token="$(executor_token)"
  [[ -n "$token" ]] || { echo "executor token unavailable" >&2; return 1; }
  _write_token_env "$token"
  export EXECUTOR_MCP_TOKEN="$token"
  if command -v hermes >/dev/null 2>&1; then
    hermes_installed=1
    _acquire_daemon_lock "$GATEWAY_RELOAD_LOCK" || {
      echo "hermes: could not acquire gateway reload lock before MCP registration" >&2
      return 1
    }
    hermes_reload_lock_held=1
  fi
  if ! _unwire_legacy; then
    [[ "$hermes_reload_lock_held" == 0 ]] || _release_daemon_lock "$GATEWAY_RELOAD_LOCK"
    echo "failed to remove existing MCP configuration" >&2
    return 1
  fi

  if command -v claude >/dev/null 2>&1; then
    claude mcp add executor "$url" -s user -t http -H "Authorization: Bearer $token" >/dev/null 2>&1 || {
      echo "claude: failed to register Executor HTTP MCP" >&2
      failed=1
    }
  fi
  if command -v codex >/dev/null 2>&1; then
    codex mcp add executor --url "$url" --bearer-token-env-var EXECUTOR_MCP_TOKEN >/dev/null 2>&1 || {
      echo "codex: failed to register Executor HTTP MCP" >&2
      failed=1
    }
  fi
  if [[ "$hermes_installed" == 1 ]]; then
    if ! hermes config set mcp_servers.executor.url "$url" >/dev/null 2>&1 ||
      ! hermes config set mcp_servers.executor.headers.Authorization "Bearer \${EXECUTOR_MCP_TOKEN}" >/dev/null 2>&1 ||
      ! hermes config set mcp_servers.executor.enabled true >/dev/null 2>&1; then
      echo "hermes: failed to register Executor HTTP MCP" >&2
      failed=1
    fi
  fi
  if [[ "$failed" != 0 ]]; then
    [[ "$hermes_reload_lock_held" == 0 ]] || _release_daemon_lock "$GATEWAY_RELOAD_LOCK"
    return 1
  fi
  if [[ "$hermes_installed" == 1 ]] && _gateway_running; then
    # The persistent workload owns gateway lifecycle. Ask it to reload on its
    # next reconciliation instead of stopping the parent gateway from a login
    # shell that the gateway itself may have launched.
    if ! _request_gateway_reload >/dev/null; then
      _release_daemon_lock "$GATEWAY_RELOAD_LOCK"
      echo "hermes: failed to request gateway reload after MCP registration" >&2
      return 1
    fi
  fi
  [[ "$hermes_reload_lock_held" == 0 ]] || _release_daemon_lock "$GATEWAY_RELOAD_LOCK"
  printf '%s\n' "$WIRE_VERSION" >"$WIRED"
  echo "executor HTTP MCP registered for claude, codex, and hermes"
}

_hermes_executor_config() {
  local config="${HERMES_HOME:-$AGENT_HOME/.hermes}/config.yaml"
  awk '
    /^mcp_servers:[[:space:]]*$/ { in_servers = 1; next }
    in_servers && /^[^[:space:]]/ { exit }
    in_servers && /^  executor:[[:space:]]*$/ { in_executor = 1; found = 1; next }
    in_executor && /^  [^[:space:]]/ { exit }
    in_executor { print }
    END { exit found ? 0 : 1 }
  ' "$config" 2>/dev/null
}

_hermes_http_config() {
  command -v hermes >/dev/null 2>&1 || return 0
  local executor_config
  executor_config="$(_hermes_executor_config)" || return 1
  grep -Fq "$(_executor_url)" <<<"$executor_config" &&
    grep -Fq "Bearer \${EXECUTOR_MCP_TOKEN}" <<<"$executor_config" &&
    grep -Eq '^    enabled:[[:space:]]+true[[:space:]]*$' <<<"$executor_config"
}

wire_once() {
  local token url
  if [[ "${WIRE_EXECUTOR_MCP:-0}" != 1 ]]; then wire_mcp; return; fi
  token="$(executor_token 2>/dev/null || true)"
  url="$(_executor_url)"
  # Freshness = version marker + current token in TOKEN_ENV + current URL in
  # the Codex and Hermes configs. The URL checks catch restores that carry
  # wiring from a box with a different executor host (e.g. loopback -> compose
  # remote).
  if [[ -f "$WIRED" && "$(cat "$WIRED")" == "$WIRE_VERSION" && -r "$TOKEN_ENV" && -n "$token" ]] &&
    grep -Fq "$token" "$TOKEN_ENV" &&
    grep -qF "url = \"$url\"" "$CODEX_HOME/config.toml" 2>/dev/null &&
    _hermes_http_config; then return 0; fi
  wire_mcp
}

write_manifest() {
  local dir="$AGENT_HOME/.config/hermes-box" tmp manifest
  dir="$AGENT_HOME/.config/hermes-box"
  manifest="$dir/runtime-manifest"
  tmp="${manifest}.tmp.$$"
  mkdir -p "$dir"
  umask 077
  {
    printf 'created_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'base_image=%s\n' "${BASE_IMAGE:-unknown}"
    printf 'node=%s\n' "$(node --version 2>/dev/null || echo missing)"
    printf 'vp=%s\n' "$(vp --version 2>/dev/null | sed -n 1p || echo missing)"
    printf 'claude=%s\n' "$(claude --version 2>/dev/null || echo missing)"
    printf 'codex=%s\n' "$(codex --version 2>/dev/null || echo missing)"
    printf 'hermes=%s\n' "$(hermes --version 2>/dev/null | head -1 || echo missing)"
    printf 'executor=%s\n' "$(executor --version 2>/dev/null || echo missing)"
  } >"$tmp"
  mv "$tmp" "$manifest"
  chmod 0600 "$manifest"
}

status() {
  local gateway_status services_count
  if [[ -e "$GATEWAY_DISABLED" ]]; then
    gateway_status=disabled
  elif _gateway_running; then
    gateway_status=running
  else
    gateway_status=stopped
  fi
  printf 'executor: %s\n' "$(_port_open && echo running || echo stopped)"
  printf 'quiesced: %s\n' "$([[ -e "$QUIESCE_FILE" ]] && echo yes || echo no)"
  printf 'hermes:   %s\n' "$(command -v hermes >/dev/null 2>&1 && echo installed || echo 'not installed')"
  printf 'gateway:  %s\n' "$gateway_status"
  if [[ -r "$HERMES_HOME/gateway_state.json" ]]; then
    printf 'platform: %s\n' "$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("gateway_state", "unknown"))' "$HERMES_HOME/gateway_state.json" 2>/dev/null || echo invalid)"
  else
    printf 'platform: no runtime state\n'
  fi
  printf 'mcp:      %s\n' "$([[ -f "$WIRED" ]] && cat "$WIRED" || echo unwired)"
  services_count="$(find "$SERVICES_DIR" -mindepth 1 -maxdepth 1 -printf x 2>/dev/null | wc -c | tr -d ' ')"
  printf "services: %s drop-in entries (run 'hb services')\n" "$services_count"
  printf 'data:     %s\n' "$(du -sh "$DATA" 2>/dev/null | cut -f1)"
}

services() { _services_helper status; }

services_reload() {
  local failed=0
  _services_reconcile || failed=1
  services || failed=1
  return "$failed"
}

versions() {
  echo "node:     $(node --version 2>/dev/null || echo -)"
  # sed -n 1p, not head -1: vp prints more after the version line, and head
  # exiting early SIGPIPEs it — under pipefail that fails the whole pipeline.
  echo "vp:       $(vp --version 2>/dev/null | sed -n 1p || echo -)"
  echo "uv:       $(uv --version 2>/dev/null || echo -)"
  echo "nvim:     $(nvim --version 2>/dev/null | head -1 || echo -)"
  echo "claude:   $(claude --version 2>/dev/null || echo -)"
  echo "codex:    $(codex --version 2>/dev/null || echo -)"
  echo "hermes:   $(hermes --version 2>/dev/null | head -1 || { command -v hermes >/dev/null 2>&1 && echo installed || echo -; })"
  echo "executor: $(executor --version 2>/dev/null || { command -v executor >/dev/null 2>&1 && echo installed || echo -; })"
}

_check() {
  local label="$1"
  shift
  if "$@"; then printf 'ok   %s\n' "$label"; else printf 'FAIL %s\n' "$label" >&2; return 1; fi
}

_command_exists() { command -v "$1" >/dev/null 2>&1; }
_hermes_state_valid() { hermes-state verify >/dev/null; }

_claude_http_config() {
  (cd "$AGENT_HOME/workspace" && claude mcp get executor 2>/dev/null) | grep -qF "$(_executor_url)"
}

_mcp_auth_works() {
  local token
  token="$(executor_token)" || return 1
  _mcp_initialize "$(_executor_url)" "$token"
}

doctor() {
  local failed=0 cmd
  for cmd in node vp uv nvim claude codex; do
    _check "$cmd installed" _command_exists "$cmd" || failed=1
  done
  if [[ "${INSTALL_HERMES:-0}" == 1 ]]; then _check "hermes installed" _command_exists hermes || failed=1; fi
  if [[ "${INSTALL_HERMES:-0}" == 1 && ! -e "$GATEWAY_DISABLED" && ! -e "$QUIESCE_FILE" ]]; then
    _check "Hermes gateway process" _gateway_running || failed=1
    _check "Hermes gateway deep status" hermes gateway status --deep || failed=1
  else
    printf 'ok   Hermes gateway intentionally disabled or quiesced\n'
  fi
  if _exec_remote; then
    # Remote executor keeps running while this box quiesces; only reachability
    # and auth are this box's concern.
    _check "executor reachable (remote $EXECUTOR_HOST)" _port_open || failed=1
    _check "executor MCP bearer accepted" _mcp_auth_works || failed=1
  elif [[ "${INSTALL_EXECUTOR:-0}" == 1 ]]; then
    _check "executor installed" _command_exists executor || failed=1
    if [[ -e "$QUIESCE_FILE" ]]; then
      _check "Executor target port closed while quiesced" _port_closed || failed=1
    else
      _check "executor listening" _port_open || failed=1
      _check "executor MCP bearer accepted" _mcp_auth_works || failed=1
    fi
  fi
  _check "durable home writable" test -w "$AGENT_HOME" || failed=1
  _check "managed profile present" test -r /etc/profile.d/hermes-box.sh || failed=1
  if [[ "${INSTALL_HERMES:-0}" == 1 ]]; then
    _check "Hermes state integrity" _hermes_state_valid || failed=1
  else
    printf 'ok   Hermes state check skipped (INSTALL_HERMES != 1)\n'
  fi
  if [[ "${WIRE_EXECUTOR_MCP:-0}" == 1 ]]; then
    _check "MCP wiring version" test "$(cat "$WIRED" 2>/dev/null)" = "$WIRE_VERSION" || failed=1
    _check "MCP token environment" test -r "$TOKEN_ENV" || failed=1
    _check "Claude HTTP MCP config" _claude_http_config || failed=1
    _check "Codex HTTP MCP config" grep -qF "url = \"$(_executor_url)\"" "$CODEX_HOME/config.toml" || failed=1
    _check "Hermes HTTP MCP config" _hermes_http_config || failed=1
  fi
  echo "info custom services have no generic health contract; inspect process state with 'hb services'"
  [[ "$failed" == 0 ]]
}

logs() {
  local name="${1:-executor}"
  if [[ "$name" == executor ]] && _exec_remote; then
    if [[ -n "${TX9_BOX_NAME:-}" ]]; then
      printf "Executor runs in a separate container; on the host run: tx9 logs %q --source executor\n" "$TX9_BOX_NAME"
    else
      echo "Executor runs in a separate container; on the host run: tx9 logs <box> --source executor"
    fi
    return 0
  fi
  [[ "$name" == hermes || "$name" == gateway ]] && name=hermes-gateway
  tail -n 200 -F "$LOGS/${name}.log"
}

main() {
  case "${1:-status}" in
    init) init ;;
    up) up ;;
    reconcile) reconcile ;;
    down | pause) pause ;;
    resume) resume ;;
    is-paused) is_paused ;;
    gateway-is-disabled) gateway_is_disabled ;;
    gateway-enable) shift; gateway_enable "$@" ;;
    gateway-disable) gateway_disable ;;
    gateway-reload-if-requested) gateway_reload_if_requested ;;
    verify-state) shift; verify_state "$@" ;;
    acknowledge-active-paths) acknowledge_active_paths ;;
    cutover-ready) cutover_ready ;;
    web) shift; web "$@" ;;
    executor-token) executor_token ;;
    wire-mcp) wire_mcp ;;
    wire-once) wire_once ;;
    write-manifest) write_manifest ;;
    doctor) doctor ;;
    status) status ;;
    services) services ;;
    services-reload) services_reload ;;
    versions) versions ;;
    logs) shift; logs "${1:-executor}" ;;
    *) echo "usage: hb {init|up|reconcile|down|pause|resume|services|services-reload|gateway-enable|gateway-disable|gateway-reload-if-requested|verify-state|acknowledge-active-paths|cutover-ready|web|wire-mcp|doctor|status|versions|logs}"; return 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
